{"title":"code_artifact (1)","html":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>きれいな まちに しよう！ごみひろい まちがいさがし</title>\n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- FontAwesome Icons -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <!-- Canvas Confetti -->\n  <script src=\"https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js\"></script>\n  <!-- Google Fonts for Friendly Japanese Font -->\n  <link href=\"https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800;900&display=swap\" rel=\"stylesheet\">\n  \n  <style>\n    body {\n      font-family: 'M PLUS Rounded 1c', sans-serif;\n      touch-action: manipulation;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n\n    /* Launch & Fade-out animation for Hanamaru badge */\n    @keyframes hanamaruLaunch {\n      0% { \n        transform: translate(0, 0) scale(0.3) rotate(-30deg); \n        opacity: 0; \n      }\n      30% { \n        transform: translate(0, -15px) scale(1.3) rotate(5deg); \n        opacity: 1; \n      }\n      60% { \n        transform: translate(0, -28px) scale(1.1) rotate(0deg); \n        opacity: 0.9; \n      }\n      100% { \n        transform: translate(0, -45px) scale(0.8) rotate(15deg); \n        opacity: 0; \n      }\n    }\n\n    .animate-hanamaru-launch {\n      animation: hanamaruLaunch 1.1s cubic-bezier(0.25, 1, 0.5, 1) forwards;\n      transform-origin: center;\n      pointer-events: none;\n    }\n\n    /* Permanent subtle badge after animation finishes */\n    @keyframes markerPop {\n      0% { transform: scale(0); opacity: 0; }\n      100% { transform: scale(1); opacity: 0.85; }\n    }\n\n    .animate-marker-pop {\n      animation: markerPop 0.3s ease-out forwards;\n    }\n\n    /* Pulse effect for interactive targets */\n    @keyframes subtlePulse {\n      0%, 100% { filter: drop-shadow(0 0 2px rgba(239, 68, 68, 0.5)); }\n      50% { filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.9)); }\n    }\n\n    .trash-target {\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n\n    .trash-target:hover {\n      animation: subtlePulse 1s infinite;\n    }\n\n    /* Custom shadow for cards */\n    .kid-card {\n      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.15), 0 8px 12px -6px rgba(0, 0, 0, 0.1);\n    }\n  </style>\n</head>\n<body class=\"bg-amber-50/80 min-h-screen flex flex-col items-center p-2 sm:p-4 text-slate-800\">\n\n  <!-- Main Container -->\n  <div class=\"max-w-6xl w-full flex flex-col items-center\">\n    \n    <!-- Title Banner -->\n    <header class=\"w-full text-center my-2 sm:my-3\">\n      <div class=\"inline-block bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-700 text-white font-extrabold text-xl sm:text-3xl md:text-4xl px-8 py-3 rounded-2xl shadow-xl border-2 border-emerald-300 transform -rotate-1\">\n        📖 きれいな まちに しよう！まちがいさがし\n      </div>\n      <p class=\"text-xs sm:text-sm font-bold text-amber-900/80 mt-2\">\n        リアルな絵本のまちで見比べよう！隠れたごみを見つけてタップしてね\n      </p>\n    </header>\n\n    <!-- Score & Control Bar -->\n    <div class=\"w-full bg-white/90 backdrop-blur rounded-2xl p-3 sm:p-4 mb-3 kid-card flex flex-wrap items-center justify-between gap-2 border border-amber-200\">\n      <div class=\"flex items-center gap-2 sm:gap-4 flex-wrap\">\n        <span class=\"bg-emerald-800 text-emerald-100 font-bold text-xs sm:text-base px-3.5 py-1.5 rounded-xl flex items-center gap-2 shadow-inner\">\n          <i class=\"fa-solid fa-magnifying-glass text-emerald-300\"></i>\n          のこり: <span id=\"remaining-count\" class=\"text-amber-300 text-lg sm:text-2xl font-black\">7</span> こ\n        </span>\n        <!-- Timer Display -->\n        <span class=\"bg-amber-100 text-amber-900 border border-amber-300 font-extrabold text-xs sm:text-base px-3.5 py-1.5 rounded-xl flex items-center gap-2 shadow-sm\">\n          <i class=\"fa-solid fa-stopwatch text-amber-600\"></i>\n          じかん: <span id=\"timer-display\" class=\"text-amber-700 text-lg sm:text-2xl font-black\">00:00</span>\n        </span>\n      </div>\n\n      <div class=\"flex items-center gap-2 sm:gap-3\">\n        <!-- Hint Button -->\n        <button id=\"btn-hint\" onclick=\"useHint()\" class=\"bg-amber-500 hover:bg-amber-600 text-white font-black px-3.5 py-2 rounded-xl border-b-4 border-amber-700 active:translate-y-0.5 flex items-center gap-1.5 text-xs sm:text-sm shadow-md transition\">\n          <i class=\"fa-solid fa-lightbulb text-yellow-200\"></i>\n          <span>ヒント (<span id=\"hint-count\">3</span>)</span>\n        </button>\n        \n        <button id=\"btn-sound\" onclick=\"toggleSound()\" class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-3 py-2 rounded-xl border border-slate-300 flex items-center gap-1.5 text-xs sm:text-sm transition\">\n          <i id=\"sound-icon\" class=\"fa-solid fa-volume-high text-emerald-600\"></i>\n          <span id=\"sound-text\">おと: オン</span>\n        </button>\n\n        <button onclick=\"resetGame()\" class=\"bg-slate-700 hover:bg-slate-800 text-white font-bold px-3.5 py-2 rounded-xl border-b-4 border-slate-900 active:translate-y-0.5 flex items-center gap-1.5 text-xs sm:text-sm shadow-md transition\">\n          <i class=\"fa-solid fa-rotate-right\"></i>\n          リセット\n        </button>\n      </div>\n    </div>\n\n    <!-- Educational Hint / Message Box -->\n    <div id=\"educational-msg-box\" class=\"w-full bg-emerald-900 text-emerald-50 rounded-2xl p-3 sm:p-4 mb-4 transition-all duration-300 flex items-center gap-3 shadow-md min-h-[60px] border border-emerald-700\">\n      <div class=\"text-2xl sm:text-3xl text-yellow-400 flex-shrink-0 animate-bounce\">\n        🎨\n      </div>\n      <div id=\"educational-text\" class=\"font-bold text-xs sm:text-base leading-relaxed\">\n        ひだりの「きれいな絵」と よく見くらべよう！右のまちに 隠れた小さな 7つの「ごみ・汚れ」をみつけてね！\n      </div>\n    </div>\n\n    <!-- Game Boards Grid -->\n    <div class=\"w-full grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\">\n      \n      <!-- LEFT: Clean Town -->\n      <div class=\"bg-slate-800 rounded-3xl p-3 sm:p-4 kid-card border-4 border-emerald-600 flex flex-col items-center relative overflow-hidden\">\n        <div class=\"bg-emerald-700 text-white font-extrabold px-5 py-1.5 rounded-full text-xs sm:text-sm mb-2 shadow-md flex items-center gap-2 border border-emerald-400\">\n          <i class=\"fa-solid fa-leaf text-emerald-300\"></i>\n          きれいな まち（おてほん）\n        </div>\n\n        <div class=\"w-full relative aspect-[4/3] rounded-2xl overflow-hidden bg-slate-900 shadow-2xl\">\n          <svg id=\"svg-clean\" viewBox=\"0 0 500 375\" class=\"w-full h-full\">\n            <defs>\n              <!-- Gradients for realistic picture-book look -->\n              <linearGradient id=\"skyGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#38bdf8\" />\n                <stop offset=\"60%\" stop-color=\"#bae6fd\" />\n                <stop offset=\"100%\" stop-color=\"#e0f2fe\" />\n              </linearGradient>\n              <linearGradient id=\"sunGlow\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#fef08a\" stop-opacity=\"1\" />\n                <stop offset=\"100%\" stop-color=\"#facc15\" stop-opacity=\"0\" />\n              </linearGradient>\n              <linearGradient id=\"brickGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stop-color=\"#9a3412\" />\n                <stop offset=\"50%\" stop-color=\"#c2410c\" />\n                <stop offset=\"100%\" stop-color=\"#7c2d12\" />\n              </linearGradient>\n              <linearGradient id=\"roofGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#b91c1c\" />\n                <stop offset=\"100%\" stop-color=\"#7f1d1d\" />\n              </linearGradient>\n              <linearGradient id=\"roadGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#475569\" />\n                <stop offset=\"100%\" stop-color=\"#1e293b\" />\n              </linearGradient>\n              <linearGradient id=\"waterGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#0284c7\" />\n                <stop offset=\"100%\" stop-color=\"#0369a1\" />\n              </linearGradient>\n              <linearGradient id=\"treeGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stop-color=\"#4ade80\" />\n                <stop offset=\"50%\" stop-color=\"#15803d\" />\n                <stop offset=\"100%\" stop-color=\"#14532d\" />\n              </linearGradient>\n              <!-- Drop Shadow Filter -->\n              <filter id=\"dropShadow\" x=\"-10%\" y=\"-10%\" width=\"130%\" height=\"130%\">\n                <feDropShadow dx=\"2\" dy=\"3\" stdDeviation=\"2\" flood-opacity=\"0.3\" />\n              </filter>\n            </defs>\n\n            <!-- Sky & Atmosphere -->\n            <rect x=\"0\" y=\"0\" width=\"500\" height=\"160\" fill=\"url(#skyGrad)\" />\n            <circle cx=\"430\" cy=\"40\" r=\"60\" fill=\"url(#sunGlow)\" />\n            <circle cx=\"430\" cy=\"40\" r=\"18\" fill=\"#fef08a\" />\n\n            <!-- Clouds with shading -->\n            <g fill=\"#ffffff\" opacity=\"0.85\" filter=\"url(#dropShadow)\">\n              <path d=\"M 40 45 Q 55 25 75 35 Q 95 20 115 38 Q 130 35 140 50 Q 145 65 125 70 L 45 70 Z\" />\n              <path d=\"M 260 30 Q 275 15 295 22 Q 315 10 335 28 Q 345 38 330 50 L 255 50 Z\" />\n            </g>\n\n            <!-- Mountains in distance -->\n            <polygon points=\"-20,160 80,85 180,160\" fill=\"#94a3b8\" opacity=\"0.5\" />\n            <polygon points=\"120,160 250,70 380,160\" fill=\"#64748b\" opacity=\"0.6\" />\n            <polygon points=\"310,160 420,95 520,160\" fill=\"#94a3b8\" opacity=\"0.5\" />\n\n            <!-- TOWN BUILDINGS -->\n            <!-- Building 1: Brick Bakery -->\n            <g filter=\"url(#dropShadow)\">\n              <rect x=\"15\" y=\"75\" width=\"75\" height=\"95\" fill=\"url(#brickGrad)\" rx=\"2\" />\n              <polygon points=\"10,75 52.5,45 95,75\" fill=\"url(#roofGrad)\" />\n              <!-- Windows with reflection -->\n              <rect x=\"28\" y=\"90\" width=\"20\" height=\"25\" fill=\"#f8fafc\" rx=\"1\" stroke=\"#451a03\" stroke-width=\"2\" />\n              <path d=\"M 28 90 L 48 115\" stroke=\"#cbd5e1\" stroke-width=\"1\" />\n              <rect x=\"58\" y=\"90\" width=\"20\" height=\"25\" fill=\"#f8fafc\" rx=\"1\" stroke=\"#451a03\" stroke-width=\"2\" />\n              <rect x=\"38\" y=\"130\" width=\"28\" height=\"40\" fill=\"#78350f\" rx=\"1\" />\n            </g>\n\n            <!-- Building 2: Clock Tower (Stone texture) -->\n            <g filter=\"url(#dropShadow)\">\n              <rect x=\"100\" y=\"35\" width=\"60\" height=\"135\" fill=\"#cbd5e1\" rx=\"2\" />\n              <polygon points=\"95,35 130,5 165,35\" fill=\"#0369a1\" />\n              <!-- Clock face -->\n              <circle cx=\"130\" cy=\"65\" r=\"16\" fill=\"#ffffff\" stroke=\"#1e293b\" stroke-width=\"2.5\" />\n              <line x1=\"130\" y1=\"65\" x2=\"130\" y2=\"55\" stroke=\"#1e293b\" stroke-width=\"2\" stroke-linecap=\"round\" />\n              <line x1=\"130\" y1=\"65\" x2=\"137\" y2=\"65\" stroke=\"#1e293b\" stroke-width=\"2\" stroke-linecap=\"round\" />\n            </g>\n\n            <!-- Building 3: Bookstore with Sign -->\n            <g filter=\"url(#dropShadow)\">\n              <rect x=\"170\" y=\"65\" width=\"85\" height=\"105\" fill=\"#fbcfe8\" rx=\"2\" />\n              <!-- Real Signboard -->\n              <rect id=\"clean-sign-bg\" x=\"180\" y=\"80\" width=\"65\" height=\"22\" fill=\"#be185d\" rx=\"3\" stroke=\"#831843\" stroke-width=\"1.5\" />\n              <text x=\"212\" y=\"95\" font-size=\"11\" font-weight=\"900\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"sans-serif\">BOOKS</text>\n              <rect x=\"185\" y=\"115\" width=\"25\" height=\"35\" fill=\"#38bdf8\" rx=\"1\" stroke=\"#0284c7\" stroke-width=\"1.5\" />\n              <rect x=\"220\" y=\"115\" width=\"25\" height=\"35\" fill=\"#38bdf8\" rx=\"1\" stroke=\"#0284c7\" stroke-width=\"1.5\" />\n            </g>\n\n            <!-- Park Area Behind Fence -->\n            <rect x=\"260\" y=\"115\" width=\"240\" height=\"55\" fill=\"#86efac\" />\n            <!-- Park Swing -->\n            <g stroke=\"#334155\" stroke-width=\"2\">\n              <line x1=\"390\" y1=\"95\" x2=\"385\" y2=\"135\" />\n              <line x1=\"390\" y1=\"95\" x2=\"398\" y2=\"135\" />\n              <line x1=\"430\" y1=\"95\" x2=\"425\" y2=\"135\" />\n              <line x1=\"430\" y1=\"95\" x2=\"438\" y2=\"135\" />\n              <line x1=\"385\" y1=\"95\" x2=\"435\" y2=\"95\" stroke-width=\"3\" />\n            </g>\n            <rect x=\"388\" y=\"125\" width=\"12\" height=\"3\" fill=\"#78350f\" />\n            <rect x=\"425\" y=\"125\" width=\"12\" height=\"3\" fill=\"#78350f\" />\n\n            <!-- Fence -->\n            <path d=\"M 260 152 L 500 152 M 260 162 L 500 162\" stroke=\"#ffffff\" stroke-width=\"2.5\" />\n            <g stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linecap=\"round\">\n              <line x1=\"275\" y1=\"145\" x2=\"275\" y2=\"168\" />\n              <line x1=\"310\" y1=\"145\" x2=\"310\" y2=\"168\" />\n              <line x1=\"345\" y1=\"145\" x2=\"345\" y2=\"168\" />\n              <line x1=\"460\" y1=\"145\" x2=\"460\" y2=\"168\" />\n              <line x1=\"485\" y1=\"145\" x2=\"485\" y2=\"168\" />\n            </g>\n\n            <!-- Ground Plaza & Sidewalk (Textured Cobblestone) -->\n            <rect x=\"0\" y=\"170\" width=\"500\" height=\"100\" fill=\"#cbd5e1\" />\n            <!-- Sidewalk curb shadow -->\n            <rect x=\"0\" y=\"262\" width=\"500\" height=\"8\" fill=\"#94a3b8\" />\n\n            <!-- Main Road Asphalt -->\n            <rect x=\"0\" y=\"270\" width=\"500\" height=\"105\" fill=\"url(#roadGrad)\" />\n            <line x1=\"0\" y1=\"320\" x2=\"500\" y2=\"320\" stroke=\"#fef08a\" stroke-width=\"4\" stroke-dasharray=\"25 20\" />\n\n            <!-- Real Drain Grate on Road Curb -->\n            <g transform=\"translate(140, 260)\" filter=\"url(#dropShadow)\">\n              <rect x=\"0\" y=\"0\" width=\"40\" height=\"10\" fill=\"#1e293b\" rx=\"1\" />\n              <line x1=\"8\" y1=\"1\" x2=\"8\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"16\" y1=\"1\" x2=\"16\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"24\" y1=\"1\" x2=\"24\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"32\" y1=\"1\" x2=\"32\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n            </g>\n\n            <!-- Fountain in Plaza Center -->\n            <g transform=\"translate(270, 190)\" filter=\"url(#dropShadow)\">\n              <ellipse cx=\"50\" cy=\"30\" rx=\"55\" ry=\"18\" fill=\"#64748b\" />\n              <ellipse cx=\"50\" cy=\"27\" rx=\"48\" ry=\"14\" fill=\"url(#waterGrad)\" />\n              <!-- Water ripples -->\n              <ellipse cx=\"50\" cy=\"27\" rx=\"30\" ry=\"8\" fill=\"none\" stroke=\"#7dd3fc\" stroke-width=\"1\" opacity=\"0.7\" />\n              <!-- Pedestal -->\n              <rect x=\"42\" y=\"-5\" width=\"16\" height=\"30\" fill=\"#94a3b8\" rx=\"2\" />\n              <!-- Water sprays with soft gradient -->\n              <path d=\"M 50 -5 C 25 -30 15 -10 20 15\" fill=\"none\" stroke=\"#e0f2fe\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.9\" />\n              <path d=\"M 50 -5 C 75 -30 85 -10 80 15\" fill=\"none\" stroke=\"#e0f2fe\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.9\" />\n            </g>\n\n            <!-- Realistic Park Bench -->\n            <g transform=\"translate(450, 80) scale(0.8)\">\n              <!-- Wall corner detail for trash spot 6 -->\n            </g>\n            <g transform=\"translate(40, 215)\" filter=\"url(#dropShadow)\">\n              <rect x=\"0\" y=\"0\" width=\"55\" height=\"7\" fill=\"#78350f\" rx=\"1\" />\n              <rect x=\"0\" y=\"-10\" width=\"55\" height=\"7\" fill=\"#78350f\" rx=\"1\" />\n              <line x1=\"8\" y1=\"7\" x2=\"5\" y2=\"22\" stroke=\"#1e293b\" stroke-width=\"3.5\" />\n              <line x1=\"47\" y1=\"7\" x2=\"50\" y2=\"22\" stroke=\"#1e293b\" stroke-width=\"3.5\" />\n            </g>\n\n            <!-- Realistic Tree -->\n            <g transform=\"translate(5, 135)\" filter=\"url(#dropShadow)\">\n              <path d=\"M 20 40 Q 25 20 18 0 Q 30 20 32 40 Z\" fill=\"#451a03\" />\n              <circle cx=\"25\" cy=\"-10\" r=\"32\" fill=\"url(#treeGrad)\" />\n              <circle cx=\"5\" cy=\"-5\" r=\"22\" fill=\"url(#treeGrad)\" />\n              <circle cx=\"42\" cy=\"-5\" r=\"22\" fill=\"url(#treeGrad)\" />\n            </g>\n\n            <!-- Subtle Spots for Clean Map matching differences -->\n            <circle cx=\"318\" cy=\"214\" r=\"2\" fill=\"#7dd3fc\" opacity=\"0.5\" />\n            <circle cx=\"20\" cy=\"225\" r=\"2\" fill=\"#15803d\" />\n            <line x1=\"362\" y1=\"268\" x2=\"370\" y2=\"268\" stroke=\"#475569\" stroke-width=\"1.5\" />\n\n            <!-- Hanamaru Layer for Left (Clean) Board -->\n            <g id=\"clean-hanamaru-layer\"></g>\n          </svg>\n        </div>\n        <p class=\"text-xs sm:text-sm font-bold text-emerald-300 mt-2 text-center\">\n          細部まで光と影が美しい、ぴかぴかの街並み\n        </p>\n      </div>\n\n      <!-- RIGHT: Dirty Town (Spot-the-difference board) -->\n      <div id=\"dirty-card\" class=\"bg-slate-800 rounded-3xl p-3 sm:p-4 kid-card border-4 border-rose-500 flex flex-col items-center relative overflow-hidden\">\n        <div class=\"bg-rose-600 text-white font-extrabold px-5 py-1.5 rounded-full text-xs sm:text-sm mb-2 shadow-md flex items-center gap-2 border border-rose-300\">\n          <i class=\"fa-solid fa-eye text-amber-200\"></i>\n          まちがいのある まち（探してタップ）\n        </div>\n\n        <div class=\"w-full relative aspect-[4/3] rounded-2xl overflow-hidden bg-slate-900 shadow-2xl\">\n          <svg id=\"svg-dirty\" viewBox=\"0 0 500 375\" class=\"w-full h-full\">\n            <defs>\n              <filter id=\"dropShadow2\" x=\"-10%\" y=\"-10%\" width=\"130%\" height=\"130%\">\n                <feDropShadow dx=\"2\" dy=\"3\" stdDeviation=\"2\" flood-opacity=\"0.3\" />\n              </filter>\n            </defs>\n\n            <!-- Exact Base Map Replica -->\n            <rect x=\"0\" y=\"0\" width=\"500\" height=\"160\" fill=\"url(#skyGrad)\" />\n            <circle cx=\"430\" cy=\"40\" r=\"60\" fill=\"url(#sunGlow)\" />\n            <circle cx=\"430\" cy=\"40\" r=\"18\" fill=\"#fef08a\" />\n\n            <g fill=\"#ffffff\" opacity=\"0.85\" filter=\"url(#dropShadow2)\">\n              <path d=\"M 40 45 Q 55 25 75 35 Q 95 20 115 38 Q 130 35 140 50 Q 145 65 125 70 L 45 70 Z\" />\n              <path d=\"M 260 30 Q 275 15 295 22 Q 315 10 335 28 Q 345 38 330 50 L 255 50 Z\" />\n            </g>\n\n            <polygon points=\"-20,160 80,85 180,160\" fill=\"#94a3b8\" opacity=\"0.5\" />\n            <polygon points=\"120,160 250,70 380,160\" fill=\"#64748b\" opacity=\"0.6\" />\n            <polygon points=\"310,160 420,95 520,160\" fill=\"#94a3b8\" opacity=\"0.5\" />\n\n            <!-- Buildings Base -->\n            <g filter=\"url(#dropShadow2)\">\n              <rect x=\"15\" y=\"75\" width=\"75\" height=\"95\" fill=\"url(#brickGrad)\" rx=\"2\" />\n              <polygon points=\"10,75 52.5,45 95,75\" fill=\"url(#roofGrad)\" />\n              <rect x=\"28\" y=\"90\" width=\"20\" height=\"25\" fill=\"#f8fafc\" rx=\"1\" stroke=\"#451a03\" stroke-width=\"2\" />\n              <path d=\"M 28 90 L 48 115\" stroke=\"#cbd5e1\" stroke-width=\"1\" />\n              <rect x=\"58\" y=\"90\" width=\"20\" height=\"25\" fill=\"#f8fafc\" rx=\"1\" stroke=\"#451a03\" stroke-width=\"2\" />\n              <rect x=\"38\" y=\"130\" width=\"28\" height=\"40\" fill=\"#78350f\" rx=\"1\" />\n            </g>\n\n            <g filter=\"url(#dropShadow2)\">\n              <rect x=\"100\" y=\"35\" width=\"60\" height=\"135\" fill=\"#cbd5e1\" rx=\"2\" />\n              <polygon points=\"95,35 130,5 165,35\" fill=\"#0369a1\" />\n              <circle cx=\"130\" cy=\"65\" r=\"16\" fill=\"#ffffff\" stroke=\"#1e293b\" stroke-width=\"2.5\" />\n              <line x1=\"130\" y1=\"65\" x2=\"130\" y2=\"55\" stroke=\"#1e293b\" stroke-width=\"2\" stroke-linecap=\"round\" />\n              <line x1=\"130\" y1=\"65\" x2=\"137\" y2=\"65\" stroke=\"#1e293b\" stroke-width=\"2\" stroke-linecap=\"round\" />\n            </g>\n\n            <g filter=\"url(#dropShadow2)\">\n              <rect x=\"170\" y=\"65\" width=\"85\" height=\"105\" fill=\"#fbcfe8\" rx=\"2\" />\n              <rect id=\"dirty-sign-bg\" x=\"180\" y=\"80\" width=\"65\" height=\"22\" fill=\"#be185d\" rx=\"3\" stroke=\"#831843\" stroke-width=\"1.5\" />\n              <text x=\"212\" y=\"95\" font-size=\"11\" font-weight=\"900\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"sans-serif\">BOOKS</text>\n              <rect x=\"185\" y=\"115\" width=\"25\" height=\"35\" fill=\"#38bdf8\" rx=\"1\" stroke=\"#0284c7\" stroke-width=\"1.5\" />\n              <rect x=\"220\" y=\"115\" width=\"25\" height=\"35\" fill=\"#38bdf8\" rx=\"1\" stroke=\"#0284c7\" stroke-width=\"1.5\" />\n            </g>\n\n            <rect x=\"260\" y=\"115\" width=\"240\" height=\"55\" fill=\"#86efac\" />\n            <g stroke=\"#334155\" stroke-width=\"2\">\n              <line x1=\"390\" y1=\"95\" x2=\"385\" y2=\"135\" />\n              <line x1=\"390\" y1=\"95\" x2=\"398\" y2=\"135\" />\n              <line x1=\"430\" y1=\"95\" x2=\"425\" y2=\"135\" />\n              <line x1=\"430\" y1=\"95\" x2=\"438\" y2=\"135\" />\n              <line x1=\"385\" y1=\"95\" x2=\"435\" y2=\"95\" stroke-width=\"3\" />\n            </g>\n            <rect x=\"388\" y=\"125\" width=\"12\" height=\"3\" fill=\"#78350f\" />\n            <rect x=\"425\" y=\"125\" width=\"12\" height=\"3\" fill=\"#78350f\" />\n\n            <path d=\"M 260 152 L 500 152 M 260 162 L 500 162\" stroke=\"#ffffff\" stroke-width=\"2.5\" />\n            <g stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linecap=\"round\">\n              <line x1=\"275\" y1=\"145\" x2=\"275\" y2=\"168\" />\n              <line x1=\"310\" y1=\"145\" x2=\"310\" y2=\"168\" />\n              <line x1=\"345\" y1=\"145\" x2=\"345\" y2=\"168\" />\n              <line x1=\"460\" y1=\"145\" x2=\"460\" y2=\"168\" />\n              <line x1=\"485\" y1=\"145\" x2=\"485\" y2=\"168\" />\n            </g>\n\n            <rect x=\"0\" y=\"170\" width=\"500\" height=\"100\" fill=\"#cbd5e1\" />\n            <rect x=\"0\" y=\"262\" width=\"500\" height=\"8\" fill=\"#94a3b8\" />\n\n            <rect x=\"0\" y=\"270\" width=\"500\" height=\"105\" fill=\"url(#roadGrad)\" />\n            <line x1=\"0\" y1=\"320\" x2=\"500\" y2=\"320\" stroke=\"#fef08a\" stroke-width=\"4\" stroke-dasharray=\"25 20\" />\n\n            <!-- Drain Base -->\n            <g transform=\"translate(140, 260)\" filter=\"url(#dropShadow2)\">\n              <rect x=\"0\" y=\"0\" width=\"40\" height=\"10\" fill=\"#1e293b\" rx=\"1\" />\n              <line x1=\"8\" y1=\"1\" x2=\"8\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"16\" y1=\"1\" x2=\"16\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"24\" y1=\"1\" x2=\"24\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n              <line x1=\"32\" y1=\"1\" x2=\"32\" y2=\"9\" stroke=\"#64748b\" stroke-width=\"2\" />\n            </g>\n\n            <!-- Fountain Base -->\n            <g transform=\"translate(270, 190)\" filter=\"url(#dropShadow2)\">\n              <ellipse cx=\"50\" cy=\"30\" rx=\"55\" ry=\"18\" fill=\"#64748b\" />\n              <ellipse cx=\"50\" cy=\"27\" rx=\"48\" ry=\"14\" fill=\"url(#waterGrad)\" />\n              <ellipse cx=\"50\" cy=\"27\" rx=\"30\" ry=\"8\" fill=\"none\" stroke=\"#7dd3fc\" stroke-width=\"1\" opacity=\"0.7\" />\n              <rect x=\"42\" y=\"-5\" width=\"16\" height=\"30\" fill=\"#94a3b8\" rx=\"2\" />\n              <path d=\"M 50 -5 C 25 -30 15 -10 20 15\" fill=\"none\" stroke=\"#e0f2fe\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.9\" />\n              <path d=\"M 50 -5 C 75 -30 85 -10 80 15\" fill=\"none\" stroke=\"#e0f2fe\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.9\" />\n            </g>\n\n            <!-- Bench Base -->\n            <g transform=\"translate(40, 215)\" filter=\"url(#dropShadow2)\">\n              <rect x=\"0\" y=\"0\" width=\"55\" height=\"7\" fill=\"#78350f\" rx=\"1\" />\n              <rect x=\"0\" y=\"-10\" width=\"55\" height=\"7\" fill=\"#78350f\" rx=\"1\" />\n              <line x1=\"8\" y1=\"7\" x2=\"5\" y2=\"22\" stroke=\"#1e293b\" stroke-width=\"3.5\" />\n              <line x1=\"47\" y1=\"7\" x2=\"50\" y2=\"22\" stroke=\"#1e293b\" stroke-width=\"3.5\" />\n            </g>\n\n            <!-- Tree Base -->\n            <g transform=\"translate(5, 135)\" filter=\"url(#dropShadow2)\">\n              <path d=\"M 20 40 Q 25 20 18 0 Q 30 20 32 40 Z\" fill=\"#451a03\" />\n              <circle cx=\"25\" cy=\"-10\" r=\"32\" fill=\"url(#treeGrad)\" />\n              <circle cx=\"5\" cy=\"-5\" r=\"22\" fill=\"url(#treeGrad)\" />\n              <circle cx=\"42\" cy=\"-5\" r=\"22\" fill=\"url(#treeGrad)\" />\n            </g>\n\n\n            <!-- Layer for Hanamaru Completion Badges, Sparkles, and Hints -->\n            <g id=\"dirty-trash-layer\"></g>\n            <g id=\"dirty-hanamaru-layer\"></g>\n            <g id=\"sparkle-layer\"></g>\n            <g id=\"hint-layer\"></g>\n\n          </svg>\n        </div>\n        <p class=\"text-xs sm:text-sm font-bold text-rose-300 mt-2 text-center\">\n          風景に自然に紛れ込んだ「小さなごみ・汚れ」を見つけてね！\n        </p>\n      </div>\n\n    </div>\n\n    <!-- Educational Bottom Tips -->\n    <div class=\"w-full bg-slate-800 border-2 border-emerald-600 rounded-2xl p-4 kid-card flex flex-col md:flex-row items-center justify-between gap-3 text-white\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"text-3xl\">🍃</div>\n        <div>\n          <h3 class=\"font-extrabold text-emerald-300 text-sm sm:text-base\">街の小さな変化に気づく大切さ</h3>\n          <p class=\"text-xs sm:text-sm text-slate-300 font-bold\">\n            本物のお散歩でも、排水口や木の根元をよく見るとポイ捨てが見つかるよ。ひとつ拾うごとに街が輝くね！\n          </p>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- VICTORY MODAL DIALOG -->\n  <div id=\"victory-modal\" class=\"fixed inset-0 bg-slate-950/75 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden opacity-0 transition-opacity duration-500\">\n    <div class=\"bg-slate-900 rounded-3xl p-6 sm:p-8 max-w-lg w-full text-center kid-card border-4 border-amber-400 transform scale-90 transition-transform duration-300 text-white\" id=\"modal-content\">\n      \n      <div class=\"text-6xl sm:text-7xl mb-2 animate-bounce\">\n        🌟 🏛️ 🏆\n      </div>\n\n      <h2 class=\"text-2xl sm:text-3xl font-black text-amber-400 mb-2\">\n        ぜんぶ 見つけられたね！\n      </h2>\n      <h3 class=\"text-base sm:text-lg font-bold text-emerald-400 mb-4\">\n        すばらしい観察力！街がピカピカに生まれ変わりました！\n      </h3>\n\n      <!-- Time Result Badge -->\n      <div class=\"bg-amber-500/20 border-2 border-amber-400 text-amber-300 rounded-2xl p-3 mb-4 flex flex-col items-center justify-center gap-1\">\n        <div class=\"flex items-center justify-center gap-2\">\n          <i class=\"fa-solid fa-stopwatch text-xl sm:text-2xl text-amber-400\"></i>\n          <span class=\"text-sm sm:text-base font-extrabold\">クリアタイム: <span id=\"clear-time-text\" class=\"text-xl sm:text-2xl text-yellow-300 font-black\">0分0秒</span></span>\n        </div>\n        <!-- Title/Rank Display -->\n        <div id=\"rank-badge-container\" class=\"mt-2 bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-900 font-black text-sm sm:text-lg px-4 py-1.5 rounded-full shadow-lg border border-yellow-200\">\n          <span id=\"rank-badge-text\">⚡ めざまし ひろいマスター！</span>\n        </div>\n      </div>\n\n      <div class=\"bg-slate-800 rounded-2xl p-4 border border-slate-700 text-slate-200 font-bold text-xs sm:text-sm mb-6 text-left leading-relaxed\">\n        <p class=\"mb-2\">\n          👏 <strong>本物の絵本のような細部までよく観察できたね！</strong>\n        </p>\n        <p>\n          見落としそうな小さなごみや汚れを取り除くことで、街の景観や自然が守られます。\n        </p>\n        <p class=\"mt-2 text-emerald-300 font-black text-center text-sm sm:text-base\">\n          現実に街を歩くときも、綺麗な街づくりを意識してみよう！\n        </p>\n      </div>\n\n      <button onclick=\"resetGame()\" class=\"w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-black text-lg sm:text-xl py-3.5 rounded-2xl shadow-xl border-b-4 border-teal-800 active:translate-y-1 transition transform\">\n        もういちど 挑戦する！ 🔄\n      </button>\n\n    </div>\n  </div>\n\n  <!-- JavaScript Game Logic -->\n  <script>\n    // Candidate pool of 10 trash items (unique locations and types)\n    const trashCandidatePool = [\n      {\n        cx: 318, cy: 212,\n        name: \"ふんすいの空き缶\",\n        msg: \"【ふんすいの ふちの 赤い缶】を発見！綺麗な水辺がもっと爽やかになったね！✨\",\n        svg: `<g transform=\"scale(1.4)\">\n                <rect x=\"-4\" y=\"-6\" width=\"8\" height=\"12\" fill=\"#ef4444\" rx=\"1.5\" stroke=\"#991b1b\" stroke-width=\"0.8\" />\n                <ellipse cx=\"0\" cy=\"-6\" rx=\"4\" ry=\"1.5\" fill=\"#e2e8f0\" />\n                <line x1=\"-3\" y1=\"-2\" x2=\"3\" y2=\"-2\" stroke=\"#ffffff\" stroke-width=\"1\" opacity=\"0.9\" />\n              </g>`\n      },\n      {\n        cx: 24, cy: 225,\n        name: \"木の根元のペットボトル\",\n        msg: \"【木のねもとの ペットボトル】を見つけたよ！木々もよろこんでお花を咲かせたよ！🌸\",\n        svg: `<g transform=\"rotate(-40) scale(1.3)\">\n                <rect x=\"-4\" y=\"-7\" width=\"8\" height=\"14\" fill=\"#bae6fd\" opacity=\"0.9\" rx=\"1.5\" stroke=\"#0284c7\" stroke-width=\"0.8\" />\n                <rect x=\"-2\" y=\"-10\" width=\"4\" height=\"3\" fill=\"#2563eb\" rx=\"0.5\" />\n              </g>`\n      },\n      {\n        cx: 366, cy: 268,\n        name: \"歩道のすみの吸い殻\",\n        msg: \"【歩道のすみの タバコの吸い殻】をひろったよ！火事やポイ捨てを防げて安心だね！🌱\",\n        svg: `<g transform=\"rotate(10) scale(1.4)\">\n                <rect x=\"-5\" y=\"-1.5\" width=\"10\" height=\"3\" fill=\"#f8fafc\" stroke=\"#64748b\" stroke-width=\"0.5\" />\n                <rect x=\"2\" y=\"-1.5\" width=\"3\" height=\"3\" fill=\"#d97706\" />\n              </g>`\n      },\n      {\n        cx: 236, cy: 91,\n        name: \"本屋さんの看板の汚れ\",\n        msg: \"【ほんやさんの かんばんの 汚れ】を拭き取ったよ！綺麗になってお店の人も喜んでいるよ！📖\",\n        svg: `<g transform=\"scale(1.3)\">\n                <path d=\"M -6 -4 Q 0 6 6 -2\" stroke=\"#1e1b4b\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" />\n              </g>`\n      },\n      {\n        cx: 154, cy: 263,\n        name: \"排水口のビニールごみ\",\n        msg: \"【はいすいこうの ビニールごみ】を取り除いたよ！詰まりがなくなって雨の日も安全！☔\",\n        svg: `<g transform=\"scale(1.3)\">\n                <path d=\"M -7 -4 Q 1 -8 7 -1 Q 3 6 -6 3 Z\" fill=\"#f1f5f9\" opacity=\"0.9\" stroke=\"#475569\" stroke-width=\"1\" />\n              </g>`\n      },\n      {\n        cx: 78, cy: 232,\n        name: \"ベンチの下のジュース染み\",\n        msg: \"【ベンチのしたの ジュースのシミ】をきれいにしたよ！みんなが気持ちよく休憩できるね！🌼\",\n        svg: `<g transform=\"scale(1.3)\">\n                <ellipse cx=\"0\" cy=\"0\" rx=\"10\" ry=\"5\" fill=\"#581c87\" opacity=\"0.6\" />\n              </g>`\n      },\n      {\n        cx: 86, cy: 162,\n        name: \"建物の角のレジ袋\",\n        msg: \"【レンガ壁の角に引っかかった袋】を取り除いたよ！風で飛ばされる前に綺麗にできたね！🦋\",\n        svg: `<g transform=\"scale(1.3)\">\n                <path d=\"M -5 -5 Q 3 -9 5 1 Q 0 8 -5 3 Z\" fill=\"#e2e8f0\" opacity=\"0.9\" stroke=\"#94a3b8\" stroke-width=\"1\" />\n              </g>`\n      },\n      {\n        cx: 410, cy: 155,\n        name: \"公園ブランコ横の紙くず\",\n        msg: \"【ぶらんこ横の ポップコーンの紙くず】を回収したよ！みんなが安全に遊べるね！チュッ🍿\",\n        svg: `<g transform=\"rotate(15) scale(1.3)\">\n                <polygon points=\"-5,-4 4,-6 6,5 -3,6\" fill=\"#fef08a\" stroke=\"#ca8a04\" stroke-width=\"0.8\" />\n              </g>`\n      },\n      {\n        cx: 130, cy: 162,\n        name: \"時計塔のたもとの缶\",\n        msg: \"【とけいとうの 下の 青い缶】を見つけたよ！シンボルの時計塔がピカピカに！⏰\",\n        svg: `<g transform=\"scale(1.3)\">\n                <rect x=\"-4\" y=\"-6\" width=\"8\" height=\"12\" fill=\"#2563eb\" rx=\"1.5\" stroke=\"#1e3a8a\" stroke-width=\"0.8\" />\n                <ellipse cx=\"0\" cy=\"-6\" rx=\"4\" ry=\"1.5\" fill=\"#e2e8f0\" />\n              </g>`\n      },\n      {\n        cx: 285, cy: 250,\n        name: \"広場の中央の落ち葉の山\",\n        msg: \"【広場の真ん中の かたまり】をおそうじしたよ！歩きやすくなったね！🍂\",\n        svg: `<g transform=\"scale(1.3)\">\n                <ellipse cx=\"0\" cy=\"0\" rx=\"7\" ry=\"4\" fill=\"#b45309\" opacity=\"0.8\" />\n                <path d=\"M -4 -2 Q 0 -6 4 -1\" fill=\"none\" stroke=\"#78350f\" stroke-width=\"1\" />\n              </g>`\n      }\n    ];\n\n    let activeTrashItems = [];\n    let remainingCount = 0;\n    let hintCount = 3;\n    let soundEnabled = true;\n\n    // Timer Variables\n    let startTime = null;\n    let timerInterval = null;\n    let elapsedSeconds = 0;\n\n    const AudioContext = window.AudioContext || window.webkitAudioContext;\n    let audioCtx = null;\n\n    function initAudio() {\n      if (!audioCtx) {\n        audioCtx = new AudioContext();\n      }\n    }\n\n    function startTimer() {\n      stopTimer();\n      elapsedSeconds = 0;\n      updateTimerDisplay();\n      startTime = Date.now();\n      timerInterval = setInterval(() => {\n        elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);\n        updateTimerDisplay();\n      }, 1000);\n    }\n\n    function stopTimer() {\n      if (timerInterval) {\n        clearInterval(timerInterval);\n        timerInterval = null;\n      }\n    }\n\n    function updateTimerDisplay() {\n      const mins = Math.floor(elapsedSeconds / 60);\n      const secs = elapsedSeconds % 60;\n      const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;\n      const timerElem = document.getElementById('timer-display');\n      if (timerElem) timerElem.textContent = formatted;\n    }\n\n    function getFormattedElapsedTime() {\n      const mins = Math.floor(elapsedSeconds / 60);\n      const secs = elapsedSeconds % 60;\n      if (mins > 0) {\n        return `${mins}分 ${secs}秒`;\n      }\n      return `${secs}秒`;\n    }\n\n    // Determine rank title based on elapsed seconds\n    function getTitleByTime(totalSeconds) {\n      if (totalSeconds <= 20) {\n        return {\n          title: \"⚡ めざまし ひろいマスター！\",\n          style: \"from-amber-400 to-yellow-300 text-slate-900\",\n          desc: \"ものすごいスピード！神レベルの観察力だね！\"\n        };\n      } else if (totalSeconds <= 40) {\n        return {\n          title: \"🌟 まちの めいたんてい！\",\n          style: \"from-emerald-400 to-teal-300 text-slate-900\",\n          desc: \"すばらしい集中力！間違いをどんどん見つけたね！\"\n        };\n      } else {\n        return {\n          title: \"🌸 ぴかぴか まもりたい！\",\n          style: \"from-rose-400 to-pink-300 text-slate-900\",\n          desc: \"じっくり丁寧に探して、街をぴかぴかにしてくれたね！\"\n        };\n      }\n    }\n\n    function toggleSound() {\n      soundEnabled = !soundEnabled;\n      const soundText = document.getElementById('sound-text');\n      const soundIcon = document.getElementById('sound-icon');\n      \n      if (soundEnabled) {\n        soundText.textContent = 'おと: オン';\n        soundIcon.className = 'fa-solid fa-volume-high text-emerald-600';\n      } else {\n        soundText.textContent = 'おと: オフ';\n        soundIcon.className = 'fa-solid fa-volume-xmark text-slate-400';\n      }\n    }\n\n    function playPopSound() {\n      if (!soundEnabled) return;\n      initAudio();\n\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(520, audioCtx.currentTime);\n      osc.frequency.exponentialRampToValueAtTime(1100, audioCtx.currentTime + 0.15);\n\n      gain.gain.setValueAtTime(0.25, audioCtx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.15);\n\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n\n      osc.start();\n      osc.stop(audioCtx.currentTime + 0.15);\n    }\n\n    function playVictoryFanfare() {\n      if (!soundEnabled) return;\n      initAudio();\n\n      const notes = [523.25, 659.25, 783.99, 1046.50];\n      notes.forEach((freq, idx) => {\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n\n        osc.type = 'triangle';\n        osc.frequency.value = freq;\n\n        const startTime = audioCtx.currentTime + (idx * 0.12);\n        gain.gain.setValueAtTime(0.2, startTime);\n        gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.35);\n\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n\n        osc.start(startTime);\n        osc.stop(startTime + 0.35);\n      });\n    }\n\n    function useHint() {\n      if (hintCount <= 0 || remainingCount <= 0) return;\n\n      const uncleaned = activeTrashItems.filter(item => !item.cleaned);\n      if (uncleaned.length === 0) return;\n\n      const target = uncleaned[Math.floor(Math.random() * uncleaned.length)];\n\n      hintCount--;\n      document.getElementById('hint-count').textContent = hintCount;\n      if (hintCount === 0) {\n        document.getElementById('btn-hint').classList.add('opacity-50', 'cursor-not-allowed');\n      }\n\n      const hintLayer = document.getElementById('hint-layer');\n      hintLayer.innerHTML = '';\n\n      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n      circle.setAttribute('cx', target.cx);\n      circle.setAttribute('cy', target.cy);\n      circle.setAttribute('r', '26');\n      circle.setAttribute('fill', 'none');\n      circle.setAttribute('stroke', '#f59e0b');\n      circle.setAttribute('stroke-width', '3.5');\n      circle.setAttribute('stroke-dasharray', '5 5');\n      circle.setAttribute('class', 'animate-spin');\n\n      hintLayer.appendChild(circle);\n\n      setTimeout(() => {\n        if (hintLayer.contains(circle)) {\n          hintLayer.removeChild(circle);\n        }\n      }, 3500);\n    }\n\n    function createFloatingHanamaru(cx, cy) {\n      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n      g.setAttribute('transform', `translate(${cx}, ${cy})`);\n      g.setAttribute('class', 'animate-hanamaru-launch');\n\n      let petalsSVG = '';\n      for (let i = 0; i < 5; i++) {\n        const angle = (i * 72) * (Math.PI / 180);\n        const px = Math.cos(angle) * 18;\n        const py = Math.sin(angle) * 18;\n        petalsSVG += `<circle cx=\"${px.toFixed(1)}\" cy=\"${py.toFixed(1)}\" r=\"8\" fill=\"#f43f5e\" opacity=\"0.9\" />`;\n      }\n\n      g.innerHTML = `\n        ${petalsSVG}\n        <circle cx=\"0\" cy=\"0\" r=\"18\" fill=\"#ffffff\" opacity=\"0.95\" />\n        <circle cx=\"0\" cy=\"0\" r=\"17\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"3\" />\n        <circle cx=\"0\" cy=\"0\" r=\"12\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"2.5\" />\n        <circle cx=\"0\" cy=\"0\" r=\"4\" fill=\"#e11d48\" />\n      `;\n\n      setTimeout(() => {\n        if (g.parentNode) {\n          g.parentNode.removeChild(g);\n        }\n      }, 1100);\n\n      return g;\n    }\n\n    function createClearedMarker(cx, cy) {\n      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n      g.setAttribute('transform', `translate(${cx}, ${cy})`);\n      g.setAttribute('class', 'animate-marker-pop');\n\n      g.innerHTML = `\n        <circle cx=\"0\" cy=\"0\" r=\"12\" fill=\"#ffffff\" stroke=\"#ef4444\" stroke-width=\"2.2\" opacity=\"0.9\" />\n        <path d=\"M -5 -1 L -1 4 L 6 -5\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n      `;\n\n      return g;\n    }\n\n    function createSVGSparkle(event) {\n      const svg = document.getElementById('svg-dirty');\n      if (!svg) return;\n      const rect = svg.getBoundingClientRect();\n      \n      let clientX = event ? event.clientX : null;\n      let clientY = event ? event.clientY : null;\n      if (!clientX && event && event.touches && event.touches.length > 0) {\n        clientX = event.touches[0].clientX;\n        clientY = event.touches[0].clientY;\n      }\n      \n      const x = clientX ? (clientX - rect.left) * (500 / rect.width) : 250;\n      const y = clientY ? (clientY - rect.top) * (375 / rect.height) : 180;\n\n      const sparkleLayer = document.getElementById('sparkle-layer');\n      \n      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n      g.setAttribute('transform', `translate(${x}, ${y})`);\n\n      g.innerHTML = `\n        <path d=\"M 0 -22 L 5 -6 L 22 0 L 5 6 L 0 22 L -5 6 L -22 0 L -5 -6 Z\" fill=\"#facc15\" stroke=\"#ffffff\" stroke-width=\"1\" />\n        <circle cx=\"-14\" cy=\"-14\" r=\"4\" fill=\"#38bdf8\" />\n        <circle cx=\"14\" cy=\"-14\" r=\"4\" fill=\"#f43f5e\" />\n        <circle cx=\"16\" cy=\"14\" r=\"3.5\" fill=\"#4ade80\" />\n      `;\n\n      sparkleLayer.appendChild(g);\n\n      setTimeout(() => {\n        if (g.parentNode) {\n          g.parentNode.removeChild(g);\n        }\n      }, 800);\n    }\n\n    function handleVictory() {\n      playVictoryFanfare();\n\n      if (typeof confetti === 'function') {\n        confetti({\n          particleCount: 160,\n          spread: 100,\n          origin: { y: 0.6 }\n        });\n      }\n\n      document.getElementById('clear-time-text').textContent = getFormattedElapsedTime();\n\n      // Set Rank Title\n      const rankInfo = getTitleByTime(elapsedSeconds);\n      const badgeElem = document.getElementById('rank-badge-text');\n      const badgeContainer = document.getElementById('rank-badge-container');\n      \n      if (badgeElem && badgeContainer) {\n        badgeElem.textContent = rankInfo.title;\n        badgeContainer.className = `mt-2 bg-gradient-to-r ${rankInfo.style} font-black text-sm sm:text-lg px-4 py-1.5 rounded-full shadow-lg border border-white/50`;\n      }\n\n      const modal = document.getElementById('victory-modal');\n      const modalContent = document.getElementById('modal-content');\n      \n      modal.classList.remove('hidden');\n      setTimeout(() => {\n        modal.classList.remove('opacity-0');\n        modalContent.classList.remove('scale-90');\n        modalContent.classList.add('scale-100');\n      }, 50);\n    }\n\n    // Direct and bulletproof trash cleanup using exact item reference\n    function cleanTrashItem(item, groupElem, event) {\n      if (!item || item.cleaned) return;\n\n      item.cleaned = true;\n      remainingCount--;\n\n      document.getElementById('remaining-count').textContent = remainingCount;\n\n      playPopSound();\n\n      // Ensure the clicked trash SVG group disappears completely\n      if (groupElem) {\n        groupElem.style.display = 'none';\n        groupElem.setAttribute('display', 'none');\n      }\n\n      // Append launch-up Hanamaru on both clean and dirty SVG boards\n      const cleanHanamaruLayer = document.getElementById('clean-hanamaru-layer');\n      const dirtyHanamaruLayer = document.getElementById('dirty-hanamaru-layer');\n\n      cleanHanamaruLayer.appendChild(createFloatingHanamaru(item.cx, item.cy));\n      dirtyHanamaruLayer.appendChild(createFloatingHanamaru(item.cx, item.cy));\n\n      // Append persistent cleared checkmark\n      cleanHanamaruLayer.appendChild(createClearedMarker(item.cx, item.cy));\n      dirtyHanamaruLayer.appendChild(createClearedMarker(item.cx, item.cy));\n\n      createSVGSparkle(event);\n\n      const msgText = document.getElementById('educational-text');\n      msgText.textContent = item.msg;\n\n      const msgBox = document.getElementById('educational-msg-box');\n      msgBox.classList.add('ring-4', 'ring-emerald-400');\n      setTimeout(() => {\n        msgBox.classList.remove('ring-4', 'ring-emerald-400');\n      }, 600);\n\n      if (remainingCount === 0) {\n        stopTimer();\n        setTimeout(handleVictory, 700);\n      }\n    }\n\n    // Render 7 non-overlapping randomly chosen trash items onto SVG\n    function renderRandomTrash() {\n      const dirtyTrashLayer = document.getElementById('dirty-trash-layer');\n      dirtyTrashLayer.innerHTML = '';\n\n      // Shuffle candidates and pick 7 without duplicates\n      const shuffled = [...trashCandidatePool].sort(() => 0.5 - Math.random());\n      const selected = shuffled.slice(0, 7);\n\n      activeTrashItems = selected.map((item) => ({\n        ...item,\n        cleaned: false\n      }));\n\n      activeTrashItems.forEach((item) => {\n        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');\n        g.setAttribute('class', 'trash-target');\n        g.style.cursor = 'pointer';\n\n        g.innerHTML = `\n          <g transform=\"translate(${item.cx}, ${item.cy})\">\n            <g style=\"pointer-events: none;\">\n              ${item.svg}\n            </g>\n            <circle cx=\"0\" cy=\"0\" r=\"32\" fill=\"#ffffff\" fill-opacity=\"0.001\" style=\"cursor: pointer; pointer-events: all;\" />\n          </g>\n        `;\n\n        let handled = false;\n        const triggerHandler = function(e) {\n          if (e) {\n            if (e.cancelable) e.preventDefault();\n            e.stopPropagation();\n          }\n          if (handled) return;\n          handled = true;\n          cleanTrashItem(item, g, e);\n        };\n\n        g.addEventListener('click', triggerHandler, true);\n        g.addEventListener('touchstart', triggerHandler, { passive: false });\n\n        dirtyTrashLayer.appendChild(g);\n      });\n\n      remainingCount = activeTrashItems.length;\n      document.getElementById('remaining-count').textContent = remainingCount;\n    }\n\n    function resetGame() {\n      // Clear layers\n      document.getElementById('clean-hanamaru-layer').innerHTML = '';\n      document.getElementById('dirty-hanamaru-layer').innerHTML = '';\n      document.getElementById('sparkle-layer').innerHTML = '';\n      document.getElementById('hint-layer').innerHTML = '';\n\n      // Reset hint count & button state\n      hintCount = 3;\n      document.getElementById('hint-count').textContent = hintCount;\n      const hintBtn = document.getElementById('btn-hint');\n      if (hintBtn) {\n        hintBtn.classList.remove('opacity-50', 'cursor-not-allowed');\n      }\n\n      // Hide victory modal\n      const modal = document.getElementById('victory-modal');\n      const modalContent = document.getElementById('modal-content');\n      modal.classList.add('opacity-0');\n      modalContent.classList.remove('scale-100');\n      modalContent.classList.add('scale-90');\n      setTimeout(() => {\n        modal.classList.add('hidden');\n      }, 300);\n\n      // Reset message\n      const msgText = document.getElementById('educational-text');\n      msgText.textContent = \"ひだりの「きれいな絵」と よく見くらべよう！右のまちに 隠れた小さな 7つの「ごみ・汚れ」をみつけてね！\";\n\n      // Render randomized trash items without overlap\n      renderRandomTrash();\n\n      // Start Timer\n      startTimer();\n    }\n\n    // Initialize Game on Window Load\n    window.addEventListener('DOMContentLoaded', () => {\n      resetGame();\n    });\n  </script>\n</body>\n</html>"}