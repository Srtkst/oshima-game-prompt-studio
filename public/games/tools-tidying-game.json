{"title":"道具片づけゲーム - Tools Tidying Game","html":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>道具片づけゲーム - Tools Tidying Game</title>\n    <style>\n        /* Modern reset and pixel font setup */\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n            user-select: none;\n            -webkit-user-select: none;\n            font-family: 'Courier New', Courier, monospace, sans-serif;\n            image-rendering: pixelated;\n            image-rendering: crisp-edges;\n        }\n\n        :root {\n            --bg-dark: #18251F;\n            --bg-card: #253930;\n            --light: #F8F7EE;\n            --accent: #DDEB98;\n            --accent-hover: #c4d873;\n            --danger: #e74c3c;\n            --success: #2ecc71;\n            --border-pixel: 4px;\n        }\n\n        body {\n            background-color: var(--bg-dark);\n            color: var(--light);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            overflow: hidden;\n            padding: 10px;\n        }\n\n        /* Container with retro border */\n        #game-container {\n            width: 100%;\n            max-width: 640px;\n            height: 520px;\n            background-color: var(--bg-card);\n            border: var(--border-pixel) solid var(--light);\n            border-radius: 8px;\n            box-shadow: 0 8px 0 #0d1511, 0 0 20px rgba(0,0,0,0.5);\n            position: relative;\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        /* Pixel style buttons */\n        .btn {\n            background-color: var(--accent);\n            color: var(--bg-dark);\n            border: 3px solid var(--light);\n            padding: 10px 18px;\n            font-size: 16px;\n            font-weight: bold;\n            cursor: pointer;\n            border-radius: 4px;\n            box-shadow: 0 4px 0 var(--bg-dark);\n            transition: all 0.1s ease;\n            text-align: center;\n            display: inline-block;\n            outline: none;\n        }\n\n        .btn:hover, .btn:focus {\n            background-color: var(--accent-hover);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 0 var(--bg-dark);\n        }\n\n        .btn:active, .btn.selected {\n            transform: translateY(2px);\n            box-shadow: 0 2px 0 var(--bg-dark);\n        }\n\n        .btn-option {\n            background-color: #344e43;\n            color: var(--light);\n            border-color: var(--accent);\n        }\n\n        .btn-option.selected {\n            background-color: var(--accent);\n            color: var(--bg-dark);\n        }\n\n        /* Screens */\n        .screen {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            display: none;\n            flex-direction: column;\n            align-items: center;\n            justify-content: space-between;\n            padding: 20px;\n            box-sizing: border-box;\n            background-color: var(--bg-card);\n        }\n\n        .screen.active {\n            display: flex;\n        }\n\n        /* Header / Titles */\n        h1 {\n            font-size: 22px;\n            text-align: center;\n            color: var(--accent);\n            text-shadow: 2px 2px #000;\n            margin-bottom: 10px;\n        }\n\n        p.description {\n            font-size: 14px;\n            line-height: 1.5;\n            text-align: center;\n            color: var(--light);\n            margin-bottom: 15px;\n            background: rgba(0,0,0,0.2);\n            padding: 10px;\n            border-radius: 6px;\n            border: 1px dashed var(--accent);\n        }\n\n        /* Control options area */\n        .setting-group {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 15px;\n            align-items: center;\n            justify-content: center;\n            width: 100%;\n        }\n\n        .setting-label {\n            font-size: 14px;\n            font-weight: bold;\n            color: var(--accent);\n        }\n\n        /* Gameplay Screen HUD */\n        #hud {\n            width: 100%;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: var(--bg-dark);\n            padding: 8px 12px;\n            border-radius: 4px;\n            border: 2px solid var(--accent);\n            font-size: 14px;\n            font-weight: bold;\n        }\n\n        .hud-item {\n            display: flex;\n            align-items: center;\n            gap: 5px;\n        }\n\n        /* Play Field Layout */\n        #play-area {\n            width: 100%;\n            flex-grow: 1;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-around;\n            align-items: center;\n            position: relative;\n            margin: 10px 0;\n        }\n\n        /* Boxes (Destinations) Container */\n        #boxes-container {\n            display: flex;\n            justify-content: space-around;\n            width: 100%;\n            gap: 10px;\n        }\n\n        .box-target {\n            flex: 1;\n            background: #1e2e26;\n            border: 3px solid var(--light);\n            border-radius: 8px;\n            padding: 8px 4px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            transition: all 0.15s;\n            position: relative;\n        }\n\n        .box-target:hover, .box-target.focused {\n            border-color: var(--accent);\n            background: #2a4237;\n            transform: scale(1.03);\n            outline: none;\n        }\n\n        .box-target .box-label {\n            font-size: 12px;\n            margin-top: 4px;\n            font-weight: bold;\n            color: var(--light);\n        }\n\n        /* Current Item Center Area */\n        #item-display-zone {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 110px;\n            width: 100%;\n            position: relative;\n        }\n\n        #current-item-box {\n            width: 80px;\n            height: 80px;\n            background: var(--bg-dark);\n            border: 3px solid var(--accent);\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 0 rgba(0,0,0,0.4);\n            animation: bounce 2s infinite ease-in-out;\n            position: relative;\n        }\n\n        @keyframes bounce {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-6px); }\n        }\n\n        /* Feedback shake animation */\n        .shake {\n            animation: shakeAnim 0.4s cubic-bezier(.36,.07,.19,.97) both;\n        }\n\n        @keyframes shakeAnim {\n            10%, 90% { transform: translate3d(-3px, 0, 0); }\n            20%, 80% { transform: translate3d(4px, 0, 0); }\n            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }\n            40%, 60% { transform: translate3d(6px, 0, 0); }\n        }\n\n        /* Floating Feedback Message */\n        #feedback-overlay {\n            position: absolute;\n            font-size: 20px;\n            font-weight: bold;\n            pointer-events: none;\n            opacity: 0;\n            transition: all 0.3s ease;\n            text-shadow: 2px 2px #000;\n            z-index: 10;\n        }\n\n        .feedback-correct {\n            color: var(--success);\n            animation: floatUp 0.6s ease-out forwards;\n        }\n\n        .feedback-wrong {\n            color: var(--danger);\n            animation: floatUp 0.6s ease-out forwards;\n        }\n\n        @keyframes floatUp {\n            0% { opacity: 1; transform: translateY(0) scale(1); }\n            100% { opacity: 0; transform: translateY(-30px) scale(1.2); }\n        }\n\n        /* Character Area */\n        #character-area {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            background: rgba(0,0,0,0.2);\n            padding: 6px 12px;\n            border-radius: 20px;\n            width: 90%;\n            justify-content: center;\n        }\n\n        #character-svg {\n            width: 48px;\n            height: 48px;\n        }\n\n        #character-dialog {\n            font-size: 12px;\n            color: var(--accent);\n            font-weight: bold;\n        }\n\n        /* Keyboard hint footer */\n        .key-hint {\n            font-size: 11px;\n            color: #a0b0a5;\n            text-align: center;\n            margin-top: 4px;\n        }\n\n        /* Result Screen styling */\n        .result-box {\n            background: var(--bg-dark);\n            border: 2px solid var(--accent);\n            padding: 20px;\n            border-radius: 8px;\n            text-align: center;\n            width: 100%;\n            max-width: 400px;\n            margin-bottom: 20px;\n        }\n\n        .result-score {\n            font-size: 32px;\n            color: var(--accent);\n            margin: 15px 0;\n            font-weight: bold;\n        }\n\n        .hint-text {\n            color: #ff9d9d;\n            font-size: 13px;\n            margin-top: 4px;\n            height: 18px;\n        }\n\n        /* Responsive adjustments */\n        @media (max-height: 550px) {\n            #game-container { height: 98vh; }\n            #item-display-zone { height: 90px; }\n            #current-item-box { width: 64px; height: 64px; }\n        }\n    </style>\n</head>\n<body>\n\n<div id=\"game-container\">\n\n    <!-- 1. TITLE SCREEN -->\n    <div id=\"screen-title\" class=\"screen active\">\n        <div>\n            <h1 id=\"txt-title\">道具片づけゲーム</h1>\n            <p style=\"text-align: center; font-size: 12px; color: var(--accent);\" id=\"txt-subtitle\">～ 集会室の交換会準備 ～</p>\n        </div>\n\n        <!-- SVG Visual Banner -->\n        <div style=\"margin: 15px 0; text-align: center;\">\n            <svg width=\"220\" height=\"80\" viewBox=\"0 0 220 80\">\n                <!-- Background Mini Shelf -->\n                <rect x=\"10\" y=\"55\" width=\"200\" height=\"8\" fill=\"#344e43\" />\n                <!-- Round / Spinning Top -->\n                <circle cx=\"45\" cy=\"40\" r=\"16\" fill=\"#e74c3c\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n                <circle cx=\"45\" cy=\"40\" r=\"6\" fill=\"#F8F7EE\" />\n                <!-- Square / Block -->\n                <rect x=\"95\" y=\"24\" width=\"30\" height=\"30\" fill=\"#3498db\" stroke=\"#F8F7EE\" stroke-width=\"2\" rx=\"3\"/>\n                <!-- Star Ornament -->\n                <polygon points=\"175,20 180,32 193,32 182,40 186,52 175,44 164,52 168,40 157,32 170,32\" fill=\"#f1c40f\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n            </svg>\n        </div>\n\n        <!-- Options: Language and Difficulty -->\n        <div style=\"width: 100%; max-width: 440px;\">\n            <div class=\"setting-group\">\n                <span class=\"setting-label\" id=\"lbl-lang\">言語/Lang:</span>\n                <button class=\"btn btn-option selected\" id=\"btn-lang-ja\" onclick=\"setLanguage('ja')\">日本語</button>\n                <button class=\"btn btn-option\" id=\"btn-lang-en\" onclick=\"setLanguage('en')\">English</button>\n            </div>\n\n            <div class=\"setting-group\">\n                <span class=\"setting-label\" id=\"lbl-diff\">難易度:</span>\n                <button class=\"btn btn-option\" id=\"btn-diff-easy\" onclick=\"setDifficulty('easy')\">かんたん</button>\n                <button class=\"btn btn-option selected\" id=\"btn-diff-normal\" onclick=\"setDifficulty('normal')\">ふつう</button>\n                <button class=\"btn btn-option\" id=\"btn-diff-hard\" onclick=\"setDifficulty('hard')\">むずかしい</button>\n            </div>\n        </div>\n\n        <button class=\"btn\" id=\"btn-to-howto\" onclick=\"showScreen('screen-howto')\" style=\"width: 80%; max-width: 300px; font-size: 18px;\">\n            つぎへ (Next)\n        </button>\n\n        <div class=\"key-hint\" id=\"txt-title-hint\">← → / Tab : 選択  |  Enter / Space : 決定</div>\n    </div>\n\n    <!-- 2. HOW TO PLAY SCREEN -->\n    <div id=\"screen-howto\" class=\"screen\">\n        <h1 id=\"txt-howto-title\">遊び方</h1>\n\n        <p class=\"description\" id=\"txt-howto-desc\">\n            集会室でひらく交換会に向けて、遊び道具を片づけよう！<br><br>\n            中央に出てくる道具（コマ・積み木・星の飾り）と同じマークの箱を選んで戻してね。<br>\n            制限時間は <b>90秒</b>！全12問を正解させよう！\n        </p>\n\n        <!-- Illustration of controls -->\n        <div style=\"background: rgba(0,0,0,0.3); padding: 12px; border-radius: 6px; width: 100%; max-width: 440px; font-size: 13px;\">\n            <div style=\"margin-bottom: 6px; color: var(--accent);\" id=\"txt-controls-title\"><b>【操作方法】</b></div>\n            <div id=\"txt-controls-body\">\n                ・キーボード: <b>[←] [→] [↑] [↓]</b> で箱を選択、<b>[Enter] / [Space]</b> で決定<br>\n                ・マウス/タッチ: 箱を直接クリックまたはタップ\n            </div>\n        </div>\n\n        <div style=\"display: flex; gap: 15px; width: 100%; max-width: 400px; justify-content: center;\">\n            <button class=\"btn btn-option\" onclick=\"showScreen('screen-title')\" id=\"btn-back-title\">もどる</button>\n            <button class=\"btn\" onclick=\"startGame()\" id=\"btn-start\" style=\"flex-grow: 1;\">スタート！</button>\n        </div>\n\n        <div class=\"key-hint\" id=\"txt-howto-hint\">Enter / Space でスタート</div>\n    </div>\n\n    <!-- 3. PLAY SCREEN -->\n    <div id=\"screen-play\" class=\"screen\">\n        <!-- HUD -->\n        <div id=\"hud\">\n            <div class=\"hud-item\"><span id=\"lbl-time\">残り時間:</span> <span id=\"val-time\" style=\"color:var(--accent);\">90</span>s</div>\n            <div class=\"hud-item\"><span id=\"lbl-progress\">問題:</span> <span id=\"val-progress\">1</span>/12</div>\n            <div class=\"hud-item\"><span id=\"lbl-score\">スコア:</span> <span id=\"val-score\" style=\"color:var(--accent);\">0</span></div>\n        </div>\n\n        <div id=\"play-area\">\n            <!-- Floating Text for Feedback -->\n            <div id=\"feedback-overlay\"></div>\n\n            <!-- Target Boxes (Top) -->\n            <div id=\"boxes-container\">\n                <!-- Round Box -->\n                <div class=\"box-target\" tabindex=\"0\" onclick=\"selectBox('round')\" id=\"box-round\">\n                    <svg width=\"44\" height=\"44\" viewBox=\"0 0 40 40\">\n                        <rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" fill=\"#344e43\" rx=\"4\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n                        <circle cx=\"20\" cy=\"20\" r=\"12\" fill=\"#e74c3c\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n                    </svg>\n                    <span class=\"box-label\" id=\"lbl-box-round\">丸 (コマ)</span>\n                </div>\n\n                <!-- Square Box -->\n                <div class=\"box-target\" tabindex=\"0\" onclick=\"selectBox('square')\" id=\"box-square\">\n                    <svg width=\"44\" height=\"44\" viewBox=\"0 0 40 40\">\n                        <rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" fill=\"#344e43\" rx=\"4\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n                        <rect x=\"10\" y=\"10\" width=\"20\" height=\"20\" fill=\"#3498db\" stroke=\"#F8F7EE\" stroke-width=\"2\" rx=\"2\"/>\n                    </svg>\n                    <span class=\"box-label\" id=\"lbl-box-square\">四角 (積み木)</span>\n                </div>\n\n                <!-- Star Box -->\n                <div class=\"box-target\" tabindex=\"0\" onclick=\"selectBox('star')\" id=\"box-star\">\n                    <svg width=\"44\" height=\"44\" viewBox=\"0 0 40 40\">\n                        <rect x=\"2\" y=\"2\" width=\"36\" height=\"36\" fill=\"#344e43\" rx=\"4\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n                        <polygon points=\"20,8 23,16 31,16 25,21 27,29 20,24 13,29 15,21 9,16 17,16\" fill=\"#f1c40f\" stroke=\"#F8F7EE\" stroke-width=\"1.5\"/>\n                    </svg>\n                    <span class=\"box-label\" id=\"lbl-box-star\">星 (飾り)</span>\n                </div>\n            </div>\n\n            <!-- Hint text displayed on wrong answer -->\n            <div class=\"hint-text\" id=\"visual-hint\"></div>\n\n            <!-- Current Item Display Zone (Center) -->\n            <div id=\"item-display-zone\">\n                <div id=\"current-item-box\">\n                    <!-- SVG Item inserted by JS -->\n                </div>\n            </div>\n\n            <!-- Pixel Helper Character -->\n            <div id=\"character-area\">\n                <svg id=\"character-svg\" viewBox=\"0 0 32 32\">\n                    <!-- Pixel Character SVG updated via JS -->\n                </svg>\n                <div id=\"character-dialog\">片づけを手伝おう！</div>\n            </div>\n        </div>\n\n        <div class=\"key-hint\" id=\"txt-play-hint\">← → キーで箱を選び、Enter / Space で片づける</div>\n    </div>\n\n    <!-- 4. RESULT SCREEN -->\n    <div id=\"screen-result\" class=\"screen\">\n        <h1 id=\"txt-result-title\">結果発表</h1>\n\n        <div class=\"result-box\">\n            <div id=\"txt-result-status\" style=\"font-size: 18px; font-weight: bold; color: var(--light);\">大成功！</div>\n            <div class=\"result-score\"><span id=\"val-final-score\">120</span> <span style=\"font-size: 16px;\">点</span></div>\n            <p id=\"txt-result-detail\" style=\"font-size: 13px; color: #a0b0a5;\">すべての道具を正しく片づけられました！</p>\n        </div>\n\n        <div style=\"display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 300px;\">\n            <button class=\"btn\" onclick=\"startGame()\" id=\"btn-retry\">もう一度あそぶ</button>\n            <button class=\"btn btn-option\" onclick=\"showScreen('screen-title')\" id=\"btn-result-title\">タイトルへもどる</button>\n        </div>\n\n        <div class=\"key-hint\" id=\"txt-result-hint\">Enter / Space でリトライ</div>\n    </div>\n\n</div>\n\n<script>\n    /* ===================================================================\n       DICTIONARY & MULTI-LANGUAGE SYSTEM\n       =================================================================== */\n    const I18N = {\n        ja: {\n            title: \"道具片づけゲーム\",\n            subtitle: \"～ 集会室の交換会準備 ～\",\n            langLbl: \"言語/Lang:\",\n            diffLbl: \"難易度:\",\n            diffEasy: \"かんたん\",\n            diffNormal: \"ふつう\",\n            diffHard: \"むずかしい\",\n            next: \"つぎへ\",\n            titleHint: \"← → / Tab : 選択  |  Enter / Space : 決定\",\n            howtoTitle: \"遊び方\",\n            howtoDesc: \"集会室でひらく交換会に向けて、遊び道具を片づけよう！<br><br>中央に出てくる道具（コマ・積み木・星の飾り）と同じマークの箱を選んで戻してね。<br>制限時間は <b>90秒</b>！全12問を正解させよう！\",\n            controlsTitle: \"【操作方法】\",\n            controlsBody: \"・キーボード: <b>[←] [→] [↑] [↓]</b> で箱を選択、<b>[Enter] / [Space]</b> で決定<br>・マウス/タッチ: 箱を直接クリックまたはタップ\",\n            back: \"もどる\",\n            start: \"スタート！\",\n            howtoHint: \"Enter / Space でスタート\",\n            timeLbl: \"残り時間:\",\n            progressLbl: \"問題:\",\n            scoreLbl: \"スコア:\",\n            boxRound: \"丸 (コマ)\",\n            boxSquare: \"四角 (積み木)\",\n            boxStar: \"星 (飾り)\",\n            playHint: \"← → キーで箱を選び、Enter / Space で片づける\",\n            charIdle: \"道具を同じ形の箱に入れよう！\",\n            charSuccess: \"せいかい！その調子！\",\n            charFail: \"おっと！形をよく確かめよう！\",\n            hintRound: \"ヒント: 丸い形の「コマ」だよ！\",\n            hintSquare: \"ヒント: 四角い形の「積み木」だよ！\",\n            hintStar: \"ヒント: 星の形の「飾り」だよ！\",\n            resultTitle: \"結果発表\",\n            resSuccess: \"クリアおめでとう！\",\n            resTimeout: \"時間切れ！\",\n            resDetailSuccess: \"すべての道具をきれいに片づけられました！\",\n            resDetailTimeout: \"時間切れになりました。もう一度挑戦してみよう！\",\n            retry: \"もう一度あそぶ\",\n            toTitle: \"タイトルへもどる\",\n            resultHint: \"Enter / Space でリトライ\"\n        },\n        en: {\n            title: \"Tools Tidying Game\",\n            subtitle: \"~ Community Room Exchange Event ~\",\n            langLbl: \"Language:\",\n            diffLbl: \"Difficulty:\",\n            diffEasy: \"Easy\",\n            diffNormal: \"Normal\",\n            diffHard: \"Hard\",\n            next: \"Next\",\n            titleHint: \"← → / Tab : Select  |  Enter / Space : Confirm\",\n            howtoTitle: \"How to Play\",\n            howtoDesc: \"Help tidy up play tools for the community exchange event!<br><br>Match each item (Spinning top, Block, Star ornament) with the box having the same shape tag.<br>Time limit: <b>90 seconds</b>! Complete all 12 items!\",\n            controlsTitle: \"【Controls】\",\n            controlsBody: \"・Keyboard: <b>[←] [→] [↑] [↓]</b> to choose box, <b>[Enter] / [Space]</b> to drop<br>・Mouse/Touch: Click or tap the box directly\",\n            back: \"Back\",\n            start: \"Start Game!\",\n            howtoHint: \"Press Enter / Space to start\",\n            timeLbl: \"Time:\",\n            progressLbl: \"Item:\",\n            scoreLbl: \"Score:\",\n            boxRound: \"Round (Top)\",\n            boxSquare: \"Square (Block)\",\n            boxStar: \"Star (Decor)\",\n            playHint: \"Use ← → keys to select box, Enter / Space to place\",\n            charIdle: \"Put each item in the matching box!\",\n            charSuccess: \"Great job! That's correct!\",\n            charFail: \"Oops! Check the shape carefully!\",\n            hintRound: \"Hint: Look for the ROUND box!\",\n            hintSquare: \"Hint: Look for the SQUARE box!\",\n            hintStar: \"Hint: Look for the STAR box!\",\n            resultTitle: \"Game Results\",\n            resSuccess: \"Clear Success!\",\n            resTimeout: \"Time's Up!\",\n            resDetailSuccess: \"All tools have been neatly organized!\",\n            resDetailTimeout: \"You ran out of time. Try again!\",\n            retry: \"Play Again\",\n            toTitle: \"Return to Title\",\n            resultHint: \"Press Enter / Space to retry\"\n        }\n    };\n\n    /* ===================================================================\n       SVG ASSET GENERATORS (16-bit Pixel Style)\n       =================================================================== */\n    const SVG_ITEMS = {\n        round: `<svg width=\"56\" height=\"56\" viewBox=\"0 0 32 32\">\n            <circle cx=\"16\" cy=\"16\" r=\"14\" fill=\"#e74c3c\" stroke=\"#F8F7EE\" stroke-width=\"2\"/>\n            <circle cx=\"16\" cy=\"16\" r=\"9\" fill=\"#c0392b\"/>\n            <circle cx=\"16\" cy=\"16\" r=\"4\" fill=\"#F8F7EE\"/>\n            <rect x=\"14\" y=\"2\" width=\"4\" height=\"6\" fill=\"#F8F7EE\" rx=\"1\"/>\n        </svg>`,\n        square: `<svg width=\"56\" height=\"56\" viewBox=\"0 0 32 32\">\n            <rect x=\"3\" y=\"3\" width=\"26\" height=\"26\" fill=\"#3498db\" stroke=\"#F8F7EE\" stroke-width=\"2\" rx=\"3\"/>\n            <rect x=\"7\" y=\"7\" width=\"18\" height=\"18\" fill=\"#2980b9\" rx=\"1\"/>\n            <path d=\"M7 7 L25 7 L25 25 Z\" fill=\"rgba(255,255,255,0.15)\"/>\n        </svg>`,\n        star: `<svg width=\"56\" height=\"56\" viewBox=\"0 0 32 32\">\n            <polygon points=\"16,2 20,11 30,11 22,17 25,27 16,21 7,27 10,17 2,11 12,11\" fill=\"#f1c40f\" stroke=\"#F8F7EE\" stroke-width=\"1.5\"/>\n            <polygon points=\"16,6 18,12 24,12 19,16 21,22 16,18 11,22 13,16 8,12 14,12\" fill=\"#f39c12\"/>\n        </svg>`\n    };\n\n    // Pixel Character Representations (Idle, Success, Fail)\n    const SVG_CHAR = {\n        idle: `<rect x=\"8\" y=\"4\" width=\"16\" height=\"14\" fill=\"#f39c12\" rx=\"2\"/>\n               <rect x=\"6\" y=\"10\" width=\"20\" height=\"16\" fill=\"#2980b9\" rx=\"3\"/>\n               <circle cx=\"12\" cy=\"9\" r=\"2\" fill=\"#18251F\"/>\n               <circle cx=\"20\" cy=\"9\" r=\"2\" fill=\"#18251F\"/>\n               <rect x=\"13\" y=\"14\" width=\"6\" height=\"2\" fill=\"#18251F\"/>`,\n        success: `<rect x=\"8\" y=\"2\" width=\"16\" height=\"14\" fill=\"#f39c12\" rx=\"2\"/>\n                  <rect x=\"4\" y=\"8\" width=\"24\" height=\"16\" fill=\"#27ae60\" rx=\"3\"/>\n                  <path d=\"M10 8 Q12 5 14 8\" stroke=\"#18251F\" stroke-width=\"2\" fill=\"none\"/>\n                  <path d=\"M18 8 Q20 5 22 8\" stroke=\"#18251F\" stroke-width=\"2\" fill=\"none\"/>\n                  <path d=\"M12 12 Q16 16 20 12\" stroke=\"#18251F\" stroke-width=\"2\" fill=\"none\"/>`,\n        fail: `<rect x=\"8\" y=\"6\" width=\"16\" height=\"14\" fill=\"#f39c12\" rx=\"2\"/>\n               <rect x=\"6\" y=\"12\" width=\"20\" height=\"16\" fill=\"#e74c3c\" rx=\"3\"/>\n               <line x1=\"10\" y1=\"8\" x2=\"14\" y2=\"12\" stroke=\"#18251F\" stroke-width=\"2\"/>\n               <line x1=\"14\" y1=\"8\" x2=\"10\" y2=\"12\" stroke=\"#18251F\" stroke-width=\"2\"/>\n               <line x1=\"18\" y1=\"8\" x2=\"22\" y2=\"12\" stroke=\"#18251F\" stroke-width=\"2\"/>\n               <line x1=\"22\" y1=\"8\" x2=\"18\" y2=\"12\" stroke=\"#18251F\" stroke-width=\"2\"/>\n               <path d=\"M13 16 Q16 13 19 16\" stroke=\"#18251F\" stroke-width=\"2\" fill=\"none\"/>`\n    };\n\n    /* ===================================================================\n       GAME STATE & CONFIGURATION\n       =================================================================== */\n    let currentLang = 'ja';\n    let currentDiff = 'normal'; // easy, normal, hard\n    let currentScreen = 'screen-title';\n\n    let gameQuestions = []; // Array of 12 item types\n    let currentQuestionIdx = 0;\n    let score = 0;\n    let timeLeft = 90;\n    let timerInterval = null;\n    let isProcessingInput = false;\n\n    // Focus state for keyboard navigation on box targets\n    const boxOrder = ['round', 'square', 'star'];\n    let currentFocusedBoxIdx = 0;\n\n    /* ===================================================================\n       CORE FUNCTIONS & UI UPDATES\n       =================================================================== */\n\n    function setLanguage(lang) {\n        currentLang = lang;\n        document.getElementById('btn-lang-ja').classList.toggle('selected', lang === 'ja');\n        document.getElementById('btn-lang-en').classList.toggle('selected', lang === 'en');\n        updateStaticText();\n    }\n\n    function setDifficulty(diff) {\n        currentDiff = diff;\n        document.getElementById('btn-diff-easy').classList.toggle('selected', diff === 'easy');\n        document.getElementById('btn-diff-normal').classList.toggle('selected', diff === 'normal');\n        document.getElementById('btn-diff-hard').classList.toggle('selected', diff === 'hard');\n    }\n\n    function updateStaticText() {\n        const t = I18N[currentLang];\n        document.getElementById('txt-title').innerText = t.title;\n        document.getElementById('txt-subtitle').innerText = t.subtitle;\n        document.getElementById('lbl-lang').innerText = t.langLbl;\n        document.getElementById('lbl-diff').innerText = t.diffLbl;\n        document.getElementById('btn-diff-easy').innerText = t.diffEasy;\n        document.getElementById('btn-diff-normal').innerText = t.diffNormal;\n        document.getElementById('btn-diff-hard').innerText = t.diffHard;\n        document.getElementById('btn-to-howto').innerText = t.next;\n        document.getElementById('txt-title-hint').innerText = t.titleHint;\n\n        document.getElementById('txt-howto-title').innerText = t.howtoTitle;\n        document.getElementById('txt-howto-desc').innerHTML = t.howtoDesc;\n        document.getElementById('txt-controls-title').innerHTML = t.controlsTitle;\n        document.getElementById('txt-controls-body').innerHTML = t.controlsBody;\n        document.getElementById('btn-back-title').innerText = t.back;\n        document.getElementById('btn-start').innerText = t.start;\n        document.getElementById('txt-howto-hint').innerText = t.howtoHint;\n\n        document.getElementById('lbl-time').innerText = t.timeLbl;\n        document.getElementById('lbl-progress').innerText = t.progressLbl;\n        document.getElementById('lbl-score').innerText = t.scoreLbl;\n        document.getElementById('lbl-box-round').innerText = t.boxRound;\n        document.getElementById('lbl-box-square').innerText = t.boxSquare;\n        document.getElementById('lbl-box-star').innerText = t.boxStar;\n        document.getElementById('txt-play-hint').innerText = t.playHint;\n\n        document.getElementById('txt-result-title').innerText = t.resultTitle;\n        document.getElementById('btn-retry').innerText = t.retry;\n        document.getElementById('btn-result-title').innerText = t.toTitle;\n        document.getElementById('txt-result-hint').innerText = t.resultHint;\n    }\n\n    function showScreen(screenId) {\n        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n        document.getElementById(screenId).classList.add('active');\n        currentScreen = screenId;\n\n        // Reset timer if exiting play screen\n        if (screenId !== 'screen-play' && timerInterval) {\n            clearInterval(timerInterval);\n            timerInterval = null;\n        }\n    }\n\n    /* ===================================================================\n       GAMEPLAY LOGIC\n       =================================================================== */\n\n    function startGame() {\n        // 1. Reset state\n        score = 0;\n        currentQuestionIdx = 0;\n        timeLeft = 90;\n        isProcessingInput = false;\n\n        // Adjust time limit according to difficulty\n        if (currentDiff === 'easy') timeLeft = 110;\n        if (currentDiff === 'hard') timeLeft = 75;\n\n        // 2. Generate 12 questions (4 of each type: round, square, star)\n        const types = ['round', 'round', 'round', 'round', 'square', 'square', 'square', 'square', 'star', 'star', 'star', 'star'];\n        // Shuffle questions\n        gameQuestions = types.sort(() => Math.random() - 0.5);\n\n        // 3. Update HUD\n        document.getElementById('val-score').innerText = score;\n        document.getElementById('val-time').innerText = timeLeft;\n        document.getElementById('val-progress').innerText = `1/12`;\n\n        // 4. Set Focus on middle box\n        currentFocusedBoxIdx = 1;\n        updateBoxFocus();\n\n        // 5. Show Game Screen & Start Timer\n        showScreen('screen-play');\n        loadQuestion();\n\n        if (timerInterval) clearInterval(timerInterval);\n        timerInterval = setInterval(updateTimer, 1000);\n    }\n\n    function updateTimer() {\n        timeLeft--;\n        document.getElementById('val-time').innerText = timeLeft;\n\n        if (timeLeft <= 0) {\n            endGame(false); // Timeout\n        }\n    }\n\n    function loadQuestion() {\n        const itemType = gameQuestions[currentQuestionIdx];\n        document.getElementById('current-item-box').innerHTML = SVG_ITEMS[itemType];\n        document.getElementById('val-progress').innerText = `${currentQuestionIdx + 1}/12`;\n        document.getElementById('visual-hint').innerText = ''; // Clear hint\n\n        setCharState('idle', I18N[currentLang].charIdle);\n        isProcessingInput = false;\n    }\n\n    function setCharState(state, text) {\n        document.getElementById('character-svg').innerHTML = SVG_CHAR[state];\n        document.getElementById('character-dialog').innerText = text;\n    }\n\n    function updateBoxFocus() {\n        boxOrder.forEach((id, idx) => {\n            const boxEl = document.getElementById(`box-${id}`);\n            if (idx === currentFocusedBoxIdx) {\n                boxEl.classList.add('focused');\n            } else {\n                boxEl.classList.remove('focused');\n            }\n        });\n    }\n\n    function selectBox(selectedType) {\n        if (isProcessingInput || currentScreen !== 'screen-play') return;\n        isProcessingInput = true;\n\n        const currentTargetType = gameQuestions[currentQuestionIdx];\n\n        if (selectedType === currentTargetType) {\n            // --- CORRECT ANSWER ---\n            score += 10;\n            document.getElementById('val-score').innerText = score;\n            showFloatingFeedback(\"+10\", \"feedback-correct\");\n            setCharState('success', I18N[currentLang].charSuccess);\n\n            // Delay next question based on difficulty\n            const delay = currentDiff === 'easy' ? 800 : (currentDiff === 'hard' ? 400 : 600);\n\n            setTimeout(() => {\n                currentQuestionIdx++;\n                if (currentQuestionIdx >= gameQuestions.length) {\n                    endGame(true); // Completed all 12 items\n                } else {\n                    loadQuestion();\n                }\n            }, delay);\n\n        } else {\n            // --- WRONG ANSWER ---\n            const itemBox = document.getElementById('current-item-box');\n            itemBox.classList.add('shake');\n            showFloatingFeedback(\"ミ ス\", \"feedback-wrong\");\n            setCharState('fail', I18N[currentLang].charFail);\n\n            // Display Visual Hint according to item shape\n            const hintKey = 'hint' + currentTargetType.charAt(0).toUpperCase() + currentTargetType.slice(1);\n            document.getElementById('visual-hint').innerText = I18N[currentLang][hintKey];\n\n            setTimeout(() => {\n                itemBox.classList.remove('shake');\n                isProcessingInput = false;\n            }, 600);\n        }\n    }\n\n    function showFloatingFeedback(text, className) {\n        const overlay = document.getElementById('feedback-overlay');\n        overlay.innerText = text;\n        overlay.className = className;\n        // Trigger reflow\n        void overlay.offsetWidth;\n    }\n\n    function endGame(isSuccess) {\n        if (timerInterval) clearInterval(timerInterval);\n\n        const t = I18N[currentLang];\n        document.getElementById('val-final-score').innerText = score;\n\n        if (isSuccess) {\n            document.getElementById('txt-result-status').innerText = t.resSuccess;\n            document.getElementById('txt-result-status').style.color = 'var(--accent)';\n            document.getElementById('txt-result-detail').innerText = t.resDetailSuccess;\n        } else {\n            document.getElementById('txt-result-status').innerText = t.resTimeout;\n            document.getElementById('txt-result-status').style.color = 'var(--danger)';\n            document.getElementById('txt-result-detail').innerText = t.resDetailTimeout;\n        }\n\n        showScreen('screen-result');\n    }\n\n    /* ===================================================================\n       KEYBOARD CONTROLS (ACCESSIBILITY & RETRO GAMEPLAY)\n       =================================================================== */\n\n    window.addEventListener('keydown', (e) => {\n        if (currentScreen === 'screen-title') {\n            if (e.key === 'Enter' || e.key === ' ') {\n                showScreen('screen-howto');\n            }\n        } else if (currentScreen === 'screen-howto') {\n            if (e.key === 'Enter' || e.key === ' ') {\n                startGame();\n            } else if (e.key === 'Escape') {\n                showScreen('screen-title');\n            }\n        } else if (currentScreen === 'screen-play') {\n            if (e.key === 'ArrowLeft' || e.key === 'a') {\n                currentFocusedBoxIdx = (currentFocusedBoxIdx + 2) % 3; // Move left\n                updateBoxFocus();\n            } else if (e.key === 'ArrowRight' || e.key === 'd') {\n                currentFocusedBoxIdx = (currentFocusedBoxIdx + 1) % 3; // Move right\n                updateBoxFocus();\n            } else if (e.key === 'Enter' || e.key === ' ') {\n                e.preventDefault();\n                selectBox(boxOrder[currentFocusedBoxIdx]);\n            }\n        } else if (currentScreen === 'screen-result') {\n            if (e.key === 'Enter' || e.key === ' ') {\n                startGame();\n            } else if (e.key === 'Escape') {\n                showScreen('screen-title');\n            }\n        }\n    });\n\n    // Initialize Language Text on load\n    window.onload = function() {\n        updateStaticText();\n    };\n</script>\n\n</body>\n</html>"}