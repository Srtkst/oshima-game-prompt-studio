{"title":"Be-Prepared-BeSafe","description":"","html":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>備えあれば患いなしゲーム / Be Prepared, Be Safe</title>\n    <style>\n        /* === デザインシステム & 基本スタイル === */\n        :root {\n            --bg-dark: #18251F;\n            --bg-light: #F8F7EE;\n            --accent: #DDEB98;\n            --accent-hover: #cbe073;\n            --card-bg: #FFFFFF;\n            --text-dark: #18251F;\n            --text-light: #F8F7EE;\n            --highlight: #FF9800;\n            --danger: #E53935;\n            --success: #4CAF50;\n            --border-radius: 16px;\n        }\n\n        * {\n            box-sizing: border-box;\n            user-select: none;\n            -webkit-user-select: none;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;\n            background-color: var(--bg-dark);\n            color: var(--text-dark);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            padding: 12px;\n            overflow: hidden;\n        }\n\n        /* ゲームコンテナ */\n        #game-container {\n            background-color: var(--bg-light);\n            width: 100%;\n            max-width: 600px;\n            height: 92vh;\n            max-height: 800px;\n            border-radius: var(--border-radius);\n            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);\n            position: relative;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n            border: 4px solid var(--accent);\n        }\n\n        /* 画面共通切り替え */\n        .screen {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            padding: 24px;\n            opacity: 0;\n            pointer-events: none;\n            transition: opacity 0.3s ease;\n            z-index: 1;\n        }\n\n        .screen.active {\n            opacity: 1;\n            pointer-events: auto;\n            z-index: 10;\n        }\n\n        /* ヘッダー・共通コンポーネント */\n        .title-header {\n            text-align: center;\n            margin-bottom: 20px;\n        }\n\n        h1 {\n            color: var(--bg-dark);\n            font-size: 1.8rem;\n            font-weight: 800;\n            line-height: 1.3;\n            margin-bottom: 8px;\n        }\n\n        h2 {\n            color: var(--bg-dark);\n            font-size: 1.4rem;\n            margin-bottom: 16px;\n            text-align: center;\n        }\n\n        .btn {\n            background-color: var(--accent);\n            color: var(--bg-dark);\n            border: 3px solid var(--bg-dark);\n            padding: 14px 28px;\n            font-size: 1.2rem;\n            font-weight: bold;\n            border-radius: 50px;\n            cursor: pointer;\n            box-shadow: 0 4px 0 var(--bg-dark);\n            transition: transform 0.1s, box-shadow 0.1s, background-color 0.2s;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 8px;\n            text-decoration: none;\n            margin: 6px;\n        }\n\n        .btn:hover {\n            background-color: var(--accent-hover);\n            transform: translateY(-2px);\n            box-shadow: 0 6px 0 var(--bg-dark);\n        }\n\n        .btn:active {\n            transform: translateY(2px);\n            box-shadow: 0 2px 0 var(--bg-dark);\n        }\n\n        .btn-secondary {\n            background-color: #E2E8F0;\n        }\n\n        .lang-switch {\n            position: absolute;\n            top: 16px;\n            right: 16px;\n            z-index: 20;\n            display: flex;\n            gap: 4px;\n            background: rgba(248, 247, 238, 0.8);\n            padding: 4px;\n            border-radius: 20px;\n            border: 2px solid var(--bg-dark);\n        }\n\n        .lang-btn {\n            background: transparent;\n            border: none;\n            padding: 6px 12px;\n            border-radius: 14px;\n            font-weight: bold;\n            cursor: pointer;\n            color: var(--bg-dark);\n            font-size: 0.9rem;\n        }\n\n        .lang-btn.active {\n            background: var(--bg-dark);\n            color: var(--bg-light);\n        }\n\n        /* === 1. タイトル画面 === */\n        #title-screen {\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            background: linear-gradient(180deg, var(--bg-light) 0%, #EBF4C8 100%);\n        }\n\n        .mascot-svg {\n            width: 140px;\n            height: 140px;\n            margin: 20px 0;\n            animation: bounce 2s infinite ease-in-out;\n        }\n\n        @keyframes bounce {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-12px); }\n        }\n\n        .notice-tag {\n            font-size: 0.85rem;\n            background-color: #E2E8F0;\n            padding: 4px 12px;\n            border-radius: 12px;\n            color: #4A5568;\n            margin-bottom: 12px;\n            display: inline-block;\n        }\n\n        /* === 2. 遊び方画面 === */\n        #how-to-screen {\n            justify-content: space-between;\n            overflow-y: auto;\n        }\n\n        .instructions-card {\n            background: #FFFFFF;\n            border: 3px solid var(--bg-dark);\n            border-radius: 16px;\n            padding: 16px;\n            margin-bottom: 16px;\n            box-shadow: 0 4px 8px rgba(0,0,0,0.05);\n        }\n\n        .rule-item {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            margin-bottom: 12px;\n            font-size: 1rem;\n            line-height: 1.4;\n        }\n\n        .rule-icon {\n            width: 44px;\n            height: 44px;\n            flex-shrink: 0;\n        }\n\n        .difficulty-selector {\n            display: flex;\n            justify-content: center;\n            gap: 8px;\n            margin: 12px 0;\n        }\n\n        .diff-btn {\n            flex: 1;\n            padding: 10px 4px;\n            font-size: 0.95rem;\n            border: 2px solid var(--bg-dark);\n            border-radius: 12px;\n            background: #FFF;\n            cursor: pointer;\n            font-weight: bold;\n            transition: all 0.2s;\n        }\n\n        .diff-btn.selected {\n            background: var(--bg-dark);\n            color: var(--accent);\n        }\n\n        .hint-box {\n            background: #FFF9C4;\n            border: 2px dashed #FBC02D;\n            padding: 10px;\n            border-radius: 10px;\n            font-size: 0.9rem;\n            text-align: center;\n            color: #5D4037;\n            margin-top: 8px;\n        }\n\n        /* === 3. メインプレイ画面 === */\n        #play-screen {\n            padding: 12px;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n        }\n\n        /* スコア＆タイマーバー */\n        .hud-bar {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background: var(--bg-dark);\n            color: var(--text-light);\n            padding: 10px 16px;\n            border-radius: 14px;\n            font-size: 1.1rem;\n            font-weight: bold;\n            z-index: 20;\n        }\n\n        .hud-item {\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .star-count {\n            color: var(--accent);\n            font-size: 1.3rem;\n        }\n\n        /* ゲームエリア */\n        #game-area {\n            flex: 1;\n            position: relative;\n            margin: 10px 0;\n            background: linear-gradient(180deg, #E3F2FD 0%, #F8F7EE 100%);\n            border: 3px solid var(--bg-dark);\n            border-radius: 16px;\n            overflow: hidden;\n        }\n\n        /* 3レーンガイド線 */\n        .lane-guide {\n            position: absolute;\n            top: 0;\n            bottom: 0;\n            width: 33.33%;\n            border-right: 2px dashed rgba(24, 37, 31, 0.15);\n            pointer-events: none;\n        }\n\n        .lane-guide:nth-child(1) { left: 0; }\n        .lane-guide:nth-child(2) { left: 33.33%; }\n        .lane-guide:nth-child(3) { left: 66.66%; border-right: none; }\n\n        /* 落下アイテム */\n        .falling-card {\n            position: absolute;\n            width: 70px;\n            height: 90px;\n            background: #FFFFFF;\n            border: 3px solid var(--bg-dark);\n            border-radius: 12px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 8px rgba(0,0,0,0.15);\n            transform: translateX(-50%);\n            z-index: 10;\n        }\n\n        .falling-card.star-card {\n            border-color: #F59E0B;\n            background: #FEF3C7;\n        }\n\n        .star-badge {\n            position: absolute;\n            top: -8px;\n            right: -8px;\n            width: 26px;\n            height: 26px;\n            background: #F59E0B;\n            color: #FFF;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 16px;\n            font-weight: bold;\n            border: 2px solid var(--bg-dark);\n        }\n\n        /* 受け皿・プレイヤー */\n        #player-container {\n            position: absolute;\n            bottom: 15px;\n            width: 33.33%;\n            height: 90px;\n            left: 33.33%; /* 初期：中央 */\n            transition: left 0.15s cubic-bezier(0.2, 0.8, 0.2, 1);\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: flex-end;\n            z-index: 15;\n        }\n\n        .tray {\n            width: 90%;\n            height: 24px;\n            background: var(--accent);\n            border: 3px solid var(--bg-dark);\n            border-radius: 12px 12px 4px 4px;\n            box-shadow: 0 4px 0 var(--bg-dark);\n            position: absolute;\n            top: 0;\n        }\n\n        .character-svg {\n            width: 65px;\n            height: 65px;\n            margin-top: 15px;\n        }\n\n        /* メッセージエフェクト */\n        .effect-pop {\n            position: absolute;\n            font-weight: 800;\n            font-size: 1.5rem;\n            pointer-events: none;\n            animation: popUp 0.6s forwards ease-out;\n            z-index: 30;\n            text-shadow: 2px 2px 0 #FFF, -2px -2px 0 #FFF, 2px -2px 0 #FFF, -2px 2px 0 #FFF;\n        }\n\n        @keyframes popUp {\n            0% { opacity: 1; transform: translate(-50%, 0) scale(0.8); }\n            50% { transform: translate(-50%, -30px) scale(1.2); }\n            100% { opacity: 0; transform: translate(-50%, -50px) scale(1); }\n        }\n\n        /* タッチ・画面操作ボタン */\n        .controls-bar {\n            display: flex;\n            gap: 12px;\n            height: 70px;\n            margin-top: 6px;\n        }\n\n        .ctrl-btn {\n            flex: 1;\n            background: #E2E8F0;\n            border: 3px solid var(--bg-dark);\n            border-radius: 16px;\n            font-size: 1.8rem;\n            font-weight: bold;\n            color: var(--bg-dark);\n            cursor: pointer;\n            box-shadow: 0 4px 0 var(--bg-dark);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: active 0.1s;\n        }\n\n        .ctrl-btn:active {\n            transform: translateY(3px);\n            box-shadow: 0 1px 0 var(--bg-dark);\n            background: var(--accent);\n        }\n\n        /* === 4. リザルト画面 === */\n        #result-screen {\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            background: linear-gradient(180deg, var(--bg-light) 0%, #F3F4F6 100%);\n        }\n\n        .result-box {\n            background: #FFF;\n            border: 4px solid var(--bg-dark);\n            border-radius: 20px;\n            padding: 24px;\n            width: 100%;\n            max-width: 420px;\n            box-shadow: 0 8px 16px rgba(0,0,0,0.1);\n            margin-bottom: 24px;\n        }\n\n        .result-status {\n            font-size: 1.8rem;\n            font-weight: 800;\n            margin-bottom: 12px;\n        }\n\n        .status-success { color: var(--success); }\n        .status-failed { color: var(--danger); }\n\n        .score-display {\n            font-size: 2.5rem;\n            font-weight: 900;\n            color: var(--bg-dark);\n            margin: 16px 0;\n        }\n\n        .result-details {\n            font-size: 1.1rem;\n            color: #4A5568;\n            margin-bottom: 8px;\n        }\n\n        /* レスポンシブ調整 */\n        @media (max-height: 650px) {\n            .mascot-svg { width: 90px; height: 90px; margin: 8px 0; }\n            h1 { font-size: 1.4rem; }\n            .instructions-card { padding: 10px; margin-bottom: 8px; }\n            .rule-item { font-size: 0.85rem; margin-bottom: 6px; }\n            .controls-bar { height: 56px; }\n        }\n    </style>\n</head>\n<body>\n\n    <div id=\"game-container\">\n        <!-- 言語切替ボタン -->\n        <div class=\"lang-switch\">\n            <button class=\"lang-btn active\" id=\"lang-ja\" onclick=\"setLanguage('ja')\">日本語</button>\n            <button class=\"lang-btn\" id=\"lang-en\" onclick=\"setLanguage('en')\">English</button>\n        </div>\n\n        <!-- 1. タイトル画面 -->\n        <div id=\"title-screen\" class=\"screen active\">\n            <span class=\"notice-tag\" data-i18n=\"disclaimer\">※このゲームは架空の創作設定です</span>\n            <h1 data-i18n=\"gameTitle\">備えあれば患いなしゲーム</h1>\n            <p style=\"color: #4A5568; font-weight: bold; margin-bottom: 10px;\" data-i18n=\"subtitle\">防災フェスタの準備を手伝おう！</p>\n            \n            <!-- マスコット（子どもキャラクター） SVG -->\n            <svg class=\"mascot-svg\" viewBox=\"0 0 100 100\">\n                <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#DDEB98\" stroke=\"#18251F\" stroke-width=\"4\"/>\n                <!-- 顔パーツ -->\n                <circle cx=\"35\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                <circle cx=\"65\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                <ellipse cx=\"28\" cy=\"50\" rx=\"4\" ry=\"2\" fill=\"#FF8A80\"/>\n                <ellipse cx=\"72\" cy=\"50\" rx=\"4\" ry=\"2\" fill=\"#FF8A80\"/>\n                <path d=\"M 38 58 Q 50 70 62 58\" fill=\"none\" stroke=\"#18251F\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n                <!-- 帽子 -->\n                <path d=\"M 15 35 Q 50 10 85 35 Z\" fill=\"#FF9800\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                <rect x=\"12\" y=\"33\" width=\"76\" height=\"6\" rx=\"3\" fill=\"#18251F\"/>\n            </svg>\n\n            <button class=\"btn\" onclick=\"goToScreen('how-to-screen')\" data-i18n=\"startBtn\">はじめる</button>\n        </div>\n\n        <!-- 2. 遊び方画面 -->\n        <div id=\"how-to-screen\" class=\"screen\">\n            <h2 data-i18n=\"howToTitle\">あそびかた</h2>\n            \n            <div class=\"instructions-card\">\n                <div class=\"rule-item\">\n                    <!-- ★つきカードSVG -->\n                    <svg class=\"rule-icon\" viewBox=\"0 0 50 60\">\n                        <rect x=\"2\" y=\"2\" width=\"46\" height=\"56\" rx=\"6\" fill=\"#FEF3C7\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                        <polygon points=\"25,10 29,18 38,18 31,24 33,33 25,28 17,33 19,24 12,18 21,18\" fill=\"#F59E0B\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                        <!-- 懐中電灯アイコン -->\n                        <path d=\"M20 38 H30 V48 H20 Z\" fill=\"#90A4AE\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                        <path d=\"M17 34 H33 V38 H17 Z\" fill=\"#FFB74D\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                    </svg>\n                    <div data-i18n=\"rule1\">画面の上から落ちてくるカードを受け皿で取ろう！<br><strong>★マークつき（10点）</strong>をあつめてね。</div>\n                </div>\n\n                <div class=\"rule-item\">\n                    <!-- マークなしカードSVG -->\n                    <svg class=\"rule-icon\" viewBox=\"0 0 50 60\">\n                        <rect x=\"2\" y=\"2\" width=\"46\" height=\"56\" rx=\"6\" fill=\"#FFFFFF\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                        <!-- ホイッスルアイコン -->\n                        <path d=\"M15 25 H28 V35 H15 Z\" fill=\"#4DD0E1\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                        <circle cx=\"32\" cy=\"30\" r=\"7\" fill=\"#4DD0E1\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                    </svg>\n                    <div data-i18n=\"rule2\">★なしの普通のカードは<strong>0点</strong>だよ。たまに2列同時に落ちてくるよ！</div>\n                </div>\n\n                <div class=\"rule-item\">\n                    <div style=\"font-size: 1.5rem; width: 44px; text-align: center;\">🎯</div>\n                    <div data-i18n=\"rule3\"><strong>制限時間 30秒</strong>のタイムアタック！時間内にハイスコアを目指そう！</div>\n                </div>\n            </div>\n\n            <!-- 難易度選択 -->\n            <div style=\"text-align: center;\">\n                <label style=\"font-weight: bold; margin-bottom: 6px; display: block;\" data-i18n=\"selectDiff\">むずかしさをえらんでね</label>\n                <div class=\"difficulty-selector\">\n                    <button class=\"diff-btn\" id=\"diff-easy\" onclick=\"setDifficulty('easy')\" data-i18n=\"diffEasy\">かんたん</button>\n                    <button class=\"diff-btn selected\" id=\"diff-normal\" onclick=\"setDifficulty('normal')\" data-i18n=\"diffNormal\">ふつう</button>\n                    <button class=\"diff-btn\" id=\"diff-hard\" onclick=\"setDifficulty('hard')\" data-i18n=\"diffHard\">むずかしい</button>\n                </div>\n                <div class=\"hint-box\" id=\"diff-hint\" data-i18n=\"hintNormal\">落下速度：標準 / ★カードの割合：標準</div>\n            </div>\n\n            <div style=\"text-align: center; margin-top: 10px;\">\n                <button class=\"btn\" onclick=\"startGame()\" data-i18n=\"gameStartBtn\">ゲームスタート！</button>\n            </div>\n        </div>\n\n        <!-- 3. メインプレイ画面 -->\n        <div id=\"play-screen\" class=\"screen\">\n            <!-- HUD -->\n            <div class=\"hud-bar\">\n                <div class=\"hud-item\">\n                    <span data-i18n=\"timeLabel\">のこり時間:</span>\n                    <span id=\"timer-text\" style=\"color: #FFD54F; font-size: 1.3rem;\">30</span>s\n                </div>\n                <div class=\"hud-item\">\n                    <span data-i18n=\"starsLabel\">★カード:</span>\n                    <span id=\"star-text\" class=\"star-count\">0</span>\n                </div>\n                <div class=\"hud-item\">\n                    <span data-i18n=\"scoreLabel\">スコア:</span>\n                    <span id=\"score-text\" style=\"color: #FFF; font-size: 1.2rem;\">0</span>\n                </div>\n            </div>\n\n            <!-- ゲームエリア -->\n            <div id=\"game-area\">\n                <div class=\"lane-guide\"></div>\n                <div class=\"lane-guide\"></div>\n                <div class=\"lane-guide\"></div>\n\n                <!-- プレイヤー (受け皿 + キャラクター) -->\n                <div id=\"player-container\">\n                    <div class=\"tray\"></div>\n                    <svg id=\"player-svg\" class=\"character-svg\" viewBox=\"0 0 100 100\">\n                        <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"#DDEB98\" stroke=\"#18251F\" stroke-width=\"4\"/>\n                        <!-- 目 (通常) -->\n                        <g id=\"eyes-normal\">\n                            <circle cx=\"35\" cy=\"45\" r=\"5\" fill=\"#18251F\"/>\n                            <circle cx=\"65\" cy=\"45\" r=\"5\" fill=\"#18251F\"/>\n                        </g>\n                        <!-- 口 (通常) -->\n                        <path id=\"mouth-normal\" d=\"M 40 60 Q 50 68 60 60\" fill=\"none\" stroke=\"#18251F\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n                        <!-- 帽子 -->\n                        <path d=\"M 20 30 Q 50 8 80 30 Z\" fill=\"#FF9800\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                        <rect x=\"16\" y=\"28\" width=\"68\" height=\"5\" rx=\"2\" fill=\"#18251F\"/>\n                    </svg>\n                </div>\n            </div>\n\n            <!-- 操作ボタン -->\n            <div class=\"controls-bar\">\n                <button class=\"ctrl-btn\" onclick=\"movePlayer(-1)\" aria-label=\"Left\">◀</button>\n                <button class=\"ctrl-btn\" onclick=\"movePlayer(1)\" aria-label=\"Right\">▶</button>\n            </div>\n        </div>\n\n        <!-- 4. リザルト画面 -->\n        <div id=\"result-screen\" class=\"screen\">\n            <div class=\"result-box\">\n                <div id=\"result-status\" class=\"result-status status-success\">タイムアップ！</div>\n                \n                <!-- リザルトキャラクター SVG -->\n                <svg id=\"result-mascot\" class=\"mascot-svg\" viewBox=\"0 0 100 100\" style=\"margin: 10px 0;\">\n                    <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#DDEB98\" stroke=\"#18251F\" stroke-width=\"4\"/>\n                    <circle cx=\"35\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                    <circle cx=\"65\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                    <path d=\"M 35 60 Q 50 75 65 60 Z\" fill=\"#FF8A80\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                    <path d=\"M 15 35 Q 50 10 85 35 Z\" fill=\"#FF9800\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                </svg>\n\n                <div class=\"result-details\">\n                    <span data-i18n=\"resultStars\">集めた★カード:</span> <strong id=\"result-stars-count\" style=\"color: #F59E0B;\">0</strong> 枚\n                </div>\n                <div class=\"score-display\">\n                    <span style=\"font-size: 1rem; color: #718096; display: block;\" data-i18n=\"finalScore\">最終スコア</span>\n                    <span id=\"result-score\">0</span> <span style=\"font-size: 1.2rem;\">点</span>\n                </div>\n                <div style=\"font-size: 1.2rem; font-weight: bold; color: #FF9800;\" id=\"result-rank-box\">\n                    <span data-i18n=\"rankLabel\">ランク: </span><span id=\"result-rank\">S</span>\n                </div>\n            </div>\n\n            <div>\n                <button class=\"btn\" onclick=\"startGame()\" data-i18n=\"retryBtn\">もう一度あそぶ</button>\n                <button class=\"btn btn-secondary\" onclick=\"goToScreen('title-screen')\" data-i18n=\"toTitleBtn\">タイトルへ</button>\n            </div>\n        </div>\n    </div>\n\n    <!-- === ゲームロジック (JavaScript) === -->\n    <script>\n        // --- 1. 多言語辞書データ (ja / en) ---\n        const i18n = {\n            ja: {\n                disclaimer: \"※このゲームは架空の創作設定です\",\n                gameTitle: \"備えあれば患いなしゲーム\",\n                subtitle: \"防災フェスタの準備を手伝おう！\",\n                startBtn: \"はじめる\",\n                howToTitle: \"あそびかた\",\n                rule1: \"画面の上から落ちてくるカードを受け皿で取ろう！<br><strong>★マークつき（10点）</strong>をあつめてね。\",\n                rule2: \"★なしの普通のカードは<strong>0点</strong>だよ。たまに2列同時に落ちてくるよ！\",\n                rule3: \"<strong>制限時間 30秒</strong>のタイムアタック！時間内にハイスコアを目指そう！\",\n                selectDiff: \"むずかしさをえらんでね\",\n                diffEasy: \"かんたん\",\n                diffNormal: \"ふつう\",\n                diffHard: \"むずかしい\",\n                hintEasy: \"落下速度：ゆっくり / 2ライン流れる確率：低い\",\n                hintNormal: \"落下速度：標準 / 2ライン流れる確率：標準\",\n                hintHard: \"落下速度：はやい / 2ライン流れる確率：高い\",\n                gameStartBtn: \"ゲームスタート！\",\n                timeLabel: \"のこり時間:\",\n                starsLabel: \"★カード:\",\n                scoreLabel: \"スコア:\",\n                resultSuccess: \"タイムアップ！⏰\",\n                resultStars: \"集めた★カード:\",\n                finalScore: \"最終スコア\",\n                rankLabel: \"評価ランク: \",\n                retryBtn: \"もう一度あそぶ\",\n                toTitleBtn: \"タイトルへ\"\n            },\n            en: {\n                disclaimer: \"* This game is a fictional creative setting\",\n                gameTitle: \"Be Prepared, Be Safe\",\n                subtitle: \"Help prepare for the Disaster Prep Fest!\",\n                startBtn: \"Start Game\",\n                howToTitle: \"How to Play\",\n                rule1: \"Catch falling cards with your tray!<br>Collect cards with <strong>★ marks (+10 pts)</strong>.\",\n                rule2: \"Cards without ★ give <strong>0 pts</strong>. Sometimes 2 cards fall at once!\",\n                rule3: \"<strong>30-second Time Attack!</strong> Aim for the highest score before time runs out!\",\n                selectDiff: \"Select Difficulty\",\n                diffEasy: \"Easy\",\n                diffNormal: \"Normal\",\n                diffHard: \"Hard\",\n                hintEasy: \"Speed: Slow / Double-line rate: Low\",\n                hintNormal: \"Speed: Normal / Double-line rate: Normal\",\n                hintHard: \"Speed: Fast / Double-line rate: High\",\n                gameStartBtn: \"Game Start!\",\n                timeLabel: \"Time:\",\n                starsLabel: \"★ Cards:\",\n                scoreLabel: \"Score:\",\n                resultSuccess: \"Time's Up! ⏰\",\n                resultStars: \"Collected ★ Cards:\",\n                finalScore: \"Final Score\",\n                rankLabel: \"Rank: \",\n                retryBtn: \"Play Again\",\n                toTitleBtn: \"Title Screen\"\n            }\n        };\n\n        let currentLang = 'ja';\n\n        function setLanguage(lang) {\n            currentLang = lang;\n            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));\n            document.getElementById(`lang-${lang}`).classList.add('active');\n\n            // テキストの一括更新\n            document.querySelectorAll('[data-i18n]').forEach(elem => {\n                const key = elem.getAttribute('data-i18n');\n                if (i18n[lang][key]) {\n                    elem.innerHTML = i18n[lang][key];\n                }\n            });\n\n            // ヒント表示の更新\n            updateDiffHint();\n        }\n\n        // --- 2. ゲーム状態管理変数 ---\n        let currentDifficulty = 'normal'; // easy, normal, hard\n        let currentLane = 1; // 0: 左, 1: 中央, 2: 右\n        let score = 0;\n        let starCardsCollected = 0;\n        let timeLeft = 30;\n        let gameTimer = null;\n        let spawnTimer = null;\n        let animFrameId = null;\n        let fallingItems = [];\n        let isGameRunning = false;\n\n        // 難易度パラメータの設定 (流速・生成間隔・ダブル落下率)\n        const diffSettings = {\n            easy: { speedMult: 0.85, doubleRate: 0.20, spawnInterval: 950 },\n            normal: { speedMult: 1.1, doubleRate: 0.35, spawnInterval: 750 },\n            hard: { speedMult: 1.45, doubleRate: 0.50, spawnInterval: 600 }\n        };\n\n        // --- 3. 画面遷移制御 ---\n        function goToScreen(screenId) {\n            // スキャン中・アニメーションの停止\n            stopGame();\n\n            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n            const target = document.getElementById(screenId);\n            if (target) {\n                target.classList.add('active');\n            }\n        }\n\n        function setDifficulty(diff) {\n            currentDifficulty = diff;\n            document.querySelectorAll('.diff-btn').forEach(btn => btn.classList.remove('selected'));\n            document.getElementById(`diff-${diff}`).classList.add('selected');\n            updateDiffHint();\n        }\n\n        function updateDiffHint() {\n            const hintElem = document.getElementById('diff-hint');\n            if (currentDifficulty === 'easy') hintElem.textContent = i18n[currentLang].hintEasy;\n            else if (currentDifficulty === 'normal') hintElem.textContent = i18n[currentLang].hintNormal;\n            else if (currentDifficulty === 'hard') hintElem.textContent = i18n[currentLang].hintHard;\n        }\n\n        // --- 4. ゲーム移動・プレイヤー操作 ---\n        function movePlayer(direction) {\n            if (!isGameRunning) return;\n            currentLane = Math.max(0, Math.min(2, currentLane + direction));\n            updatePlayerPosition();\n        }\n\n        function updatePlayerPosition() {\n            const playerContainer = document.getElementById('player-container');\n            // 3つのレーン位置: 0%, 33.33%, 66.66%\n            playerContainer.style.left = `${currentLane * 33.33}%`;\n        }\n\n        // キーボード操作対応\n        window.addEventListener('keydown', (e) => {\n            const activeScreen = document.querySelector('.screen.active').id;\n\n            if (activeScreen === 'play-screen') {\n                if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {\n                    movePlayer(-1);\n                } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {\n                    movePlayer(1);\n                }\n            } else {\n                if (e.key === 'Enter' || e.key === ' ') {\n                    if (activeScreen === 'title-screen') goToScreen('how-to-screen');\n                    else if (activeScreen === 'how-to-screen') startGame();\n                    else if (activeScreen === 'result-screen') startGame();\n                }\n            }\n        });\n\n        // --- 5. ゲームループ & アイテム落下処理 ---\n        function startGame() {\n            goToScreen('play-screen');\n\n            // 初期化\n            score = 0;\n            starCardsCollected = 0;\n            timeLeft = 30;\n            currentLane = 1;\n            fallingItems = [];\n            isGameRunning = true;\n\n            updatePlayerPosition();\n            updateHUD();\n\n            // 既存のドロップアイテム要素をクリア\n            const gameArea = document.getElementById('game-area');\n            document.querySelectorAll('.falling-card').forEach(el => el.remove());\n\n            // タイマー開始\n            clearInterval(gameTimer);\n            gameTimer = setInterval(() => {\n                timeLeft--;\n                updateHUD();\n                if (timeLeft <= 0) {\n                    endGame();\n                }\n            }, 1000);\n\n            // アイテム生成タイマー\n            clearInterval(spawnTimer);\n            const setting = diffSettings[currentDifficulty];\n            spawnTimer = setInterval(() => {\n                if (isGameRunning) spawnItem();\n            }, setting.spawnInterval);\n\n            // アニメーションループ開始\n            lastFrameTime = performance.now();\n            if (animFrameId) cancelAnimationFrame(animFrameId);\n            animFrameId = requestAnimationFrame(gameLoop);\n        }\n\n        function stopGame() {\n            isGameRunning = false;\n            clearInterval(gameTimer);\n            clearInterval(spawnTimer);\n            if (animFrameId) cancelAnimationFrame(animFrameId);\n        }\n\n        // SVGカードコンテンツ生成ヘルパー\n        function createCardSVG(isStar, itemType) {\n            const starBadge = isStar ? `<div class=\"star-badge\">★</div>` : '';\n            let iconSvg = '';\n\n            if (itemType === 0) {\n                // 懐中電灯 SVG\n                iconSvg = `\n                    <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n                        <path d=\"M15 12 H25 V28 H15 Z\" fill=\"#90A4AE\" stroke=\"#18251F\" stroke-width=\"2\"/>\n                        <path d=\"M12 7 H28 V12 H12 Z\" fill=\"#FFB74D\" stroke=\"#18251F\" stroke-width=\"2\"/>\n                        <circle cx=\"20\" cy=\"20\" r=\"3\" fill=\"#18251F\"/>\n                        ${isStar ? '<path d=\"M7 5 L2 2 M33 5 L38 2 M20 2 V-2\" stroke=\"#F59E0B\" stroke-width=\"2\"/>' : ''}\n                    </svg>`;\n            } else {\n                // ホイッスル SVG\n                iconSvg = `\n                    <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\">\n                        <path d=\"M10 18 H22 V28 H10 Z\" fill=\"#4DD0E1\" stroke=\"#18251F\" stroke-width=\"2\"/>\n                        <circle cx=\"25\" cy=\"23\" r=\"7\" fill=\"#4DD0E1\" stroke=\"#18251F\" stroke-width=\"2\"/>\n                        <path d=\"M10 18 L18 10 H24 L18 18 Z\" fill=\"#26C6DA\" stroke=\"#18251F\" stroke-width=\"1.5\"/>\n                    </svg>`;\n            }\n\n            return `${starBadge}${iconSvg}`;\n        }\n\n        function spawnItem() {\n            const gameArea = document.getElementById('game-area');\n            const setting = diffSettings[currentDifficulty];\n            \n            // 低確率で2列同時にセット落下するかの判定\n            const isDouble = Math.random() < setting.doubleRate;\n\n            if (isDouble) {\n                // 3つのレーンからランダムに異なる2つのレーンを選択\n                const lanes = [0, 1, 2];\n                const lane1 = lanes.splice(Math.floor(Math.random() * lanes.length), 1)[0];\n                const lane2 = lanes[0];\n\n                // 2つのうち片方を必ず★カード（10点）、もう片方を★なしカード（0点）にする\n                const starLane = Math.random() < 0.5 ? lane1 : lane2;\n                const normalLane = (starLane === lane1) ? lane2 : lane1;\n\n                createSingleFallingCard(gameArea, starLane, true);\n                createSingleFallingCard(gameArea, normalLane, false);\n            } else {\n                // 通常時：1つのレーンにランダム落下 (50%の確率で★カード)\n                const lane = Math.floor(Math.random() * 3);\n                const isStar = Math.random() < 0.5;\n                createSingleFallingCard(gameArea, lane, isStar);\n            }\n        }\n\n        function createSingleFallingCard(container, lane, isStar) {\n            const itemType = Math.floor(Math.random() * 2); // 0: 懐中電灯, 1: ホイッスル\n\n            const cardEl = document.createElement('div');\n            cardEl.className = `falling-card ${isStar ? 'star-card' : ''}`;\n            cardEl.innerHTML = createCardSVG(isStar, itemType);\n            \n            // 簡単モードの補助グラフィック（★カード強調）\n            if (currentDifficulty === 'easy' && isStar) {\n                cardEl.style.boxShadow = '0 0 12px #F59E0B';\n            }\n\n            const leftPercent = (lane * 33.33) + 16.66;\n            cardEl.style.left = `${leftPercent}%`;\n            cardEl.style.top = `-100px`;\n\n            container.appendChild(cardEl);\n\n            fallingItems.push({\n                element: cardEl,\n                lane: lane,\n                y: -100,\n                isStar: isStar\n            });\n        }\n\n        let lastFrameTime = 0;\n        function gameLoop(time) {\n            if (!isGameRunning) return;\n\n            const delta = (time - lastFrameTime) / 1000;\n            lastFrameTime = time;\n\n            const setting = diffSettings[currentDifficulty];\n            const baseSpeed = 260 * setting.speedMult; // 落下速度 (px/s)\n            const gameAreaHeight = document.getElementById('game-area').clientHeight;\n            const catchZoneY = gameAreaHeight - 100; // キャッチ判定高さ\n\n            for (let i = fallingItems.length - 1; i >= 0; i--) {\n                const item = fallingItems[i];\n                item.y += baseSpeed * (delta || 0.016);\n                item.element.style.top = `${item.y}px`;\n\n                // キャッチ判定\n                if (item.y >= catchZoneY - 20 && item.y <= catchZoneY + 30) {\n                    if (item.lane === currentLane) {\n                        // キャッチ成功！\n                        onCatch(item);\n                        item.element.remove();\n                        fallingItems.splice(i, 1);\n                        continue;\n                    }\n                }\n\n                // 画面外（下部）通過\n                if (item.y > gameAreaHeight + 20) {\n                    item.element.remove();\n                    fallingItems.splice(i, 1);\n                }\n            }\n\n            animFrameId = requestAnimationFrame(gameLoop);\n        }\n\n        // --- 6. キャッチ時の処理 & 視覚効果 ---\n        function onCatch(item) {\n            const gameArea = document.getElementById('game-area');\n            const pop = document.createElement('div');\n            pop.className = 'effect-pop';\n            pop.style.left = `${(item.lane * 33.33) + 16.66}%`;\n            pop.style.top = `${gameArea.clientHeight - 110}px`;\n\n            if (item.isStar) {\n                score += 10;\n                starCardsCollected += 1;\n                pop.textContent = '+10★';\n                pop.style.color = '#F59E0B';\n                \n                // 表情アニメーション (笑顔)\n                animateFace('happy');\n            } else {\n                pop.textContent = '+0';\n                pop.style.color = '#718096';\n            }\n\n            gameArea.appendChild(pop);\n            setTimeout(() => pop.remove(), 600);\n\n            updateHUD();\n        }\n\n        function animateFace(type) {\n            const mouth = document.getElementById('mouth-normal');\n            if (!mouth) return;\n\n            if (type === 'happy') {\n                mouth.setAttribute('d', 'M 35 58 Q 50 78 65 58 Z');\n                mouth.setAttribute('fill', '#FF8A80');\n                setTimeout(() => {\n                    mouth.setAttribute('d', 'M 40 60 Q 50 68 60 60');\n                    mouth.setAttribute('fill', 'none');\n                }, 400);\n            }\n        }\n\n        function updateHUD() {\n            document.getElementById('timer-text').textContent = timeLeft;\n            document.getElementById('star-text').textContent = starCardsCollected;\n            document.getElementById('score-text').textContent = score;\n        }\n\n        // --- 7. ゲーム終了 & リザルト ---\n        function endGame() {\n            stopGame();\n\n            const statusElem = document.getElementById('result-status');\n            const resultMascot = document.getElementById('result-mascot');\n\n            statusElem.textContent = i18n[currentLang].resultSuccess;\n            statusElem.className = 'result-status status-success';\n\n            // スコアに基づく評価ランク算出 (S, A, B, C)\n            let rank = 'C';\n            if (score >= 200) rank = 'S★';\n            else if (score >= 140) rank = 'A';\n            else if (score >= 80) rank = 'B';\n            else rank = 'C';\n\n            document.getElementById('result-rank').textContent = rank;\n\n            if (score >= 120) {\n                // 高得点時の成功表情\n                resultMascot.innerHTML = `\n                    <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#DDEB98\" stroke=\"#18251F\" stroke-width=\"4\"/>\n                    <path d=\"M 28 42 Q 35 34 42 42\" stroke=\"#18251F\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n                    <path d=\"M 58 42 Q 65 34 72 42\" stroke=\"#18251F\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n                    <path d=\"M 35 58 Q 50 78 65 58 Z\" fill=\"#FF8A80\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                    <path d=\"M 15 35 Q 50 10 85 35 Z\" fill=\"#FF9800\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                    <polygon points=\"50,5 53,12 60,12 55,16 57,23 50,19 43,23 45,16 40,12 47,12\" fill=\"#F59E0B\"/>\n                `;\n            } else {\n                // 標準・おしい表情\n                resultMascot.innerHTML = `\n                    <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#DDEB98\" stroke=\"#18251F\" stroke-width=\"4\"/>\n                    <circle cx=\"35\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                    <circle cx=\"65\" cy=\"42\" r=\"5\" fill=\"#18251F\"/>\n                    <path d=\"M 38 58 Q 50 70 62 58\" fill=\"none\" stroke=\"#18251F\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n                    <path d=\"M 15 35 Q 50 10 85 35 Z\" fill=\"#FF9800\" stroke=\"#18251F\" stroke-width=\"3\"/>\n                `;\n            }\n\n            document.getElementById('result-stars-count').textContent = starCardsCollected;\n            document.getElementById('result-score').textContent = score;\n\n            goToScreen('result-screen');\n        }\n\n        // 初期表示設定\n        setLanguage('ja');\n    </script>\n</body>\n</html>"}