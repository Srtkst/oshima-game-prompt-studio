{"title":"分けて、つなごう","html":"<!doctype html>\n<html lang=\"ja\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>分けて、つなごう</title>\n<style>\n  :root { font: 17px/1.55 system-ui, sans-serif; color: #18251f; background: #f8f7ee; }\n  * { box-sizing: border-box; }\n  body { margin: 0; }\n  main { width: min(600px, calc(100% - 24px)); margin: 26px auto; }\n  header { display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-bottom: 12px; }\n  section { background: #fffef6; border: 2px solid #c9d5b7; border-radius: 18px; padding: clamp(16px, 5vw, 34px); }\n  h1, h2, p { margin: 0 0 14px; }\n  button, select { font: inherit; color: inherit; background: #ddeb98; border: 1px solid #77844f; border-radius: 9px; min-height: 44px; padding: 8px 12px; cursor: pointer; }\n  :focus-visible { outline: 3px solid #3c6b58; outline-offset: 3px; }\n  .scene { font-size: 46px; letter-spacing: .25em; color: #54795a; }\n  .stats { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px; font-size: .88rem; }\n  .item { display: grid; justify-items: center; border-radius: 13px; margin: 12px 0; background: #eff1dd; padding: 10px; }\n  .shape { font-size: 2.4rem; line-height: 1.2; }\n  .bins { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\n  .bins button { display: grid; justify-items: center; min-width: 0; padding-inline: 4px; font-size: .82rem; }\n  .bins button[data-hint] { outline: 3px dashed #33634c; outline-offset: -4px; }\n  #feedback { margin: 12px 0 0; min-height: 1.6em; }\n</style>\n<main>\n  <header>\n    <label for=\"language\" data-text=\"language\">言語</label>\n    <select id=\"language\"><option value=\"ja\">日本語</option><option value=\"en\">English</option></select>\n    <button type=\"button\" id=\"sound\" aria-pressed=\"false\" data-text=\"mute\">ミュート</button>\n  </header>\n  <section id=\"title-screen\">\n    <div class=\"scene\" aria-hidden=\"true\">●■★</div>\n    <h1 tabindex=\"-1\" data-text=\"title\">分けて、つなごう</h1>\n    <p data-text=\"story\">集会室で開く交換会の準備を手伝おう。形を見て、遊び道具を箱へ戻します。</p>\n    <button type=\"button\" id=\"instructions\" data-text=\"instructions\">遊び方</button>\n  </section>\n  <section id=\"instructions-screen\" hidden>\n    <h2 tabindex=\"-1\" data-text=\"instructions\">遊び方</h2>\n    <p data-text=\"how\">道具と同じ形の箱を選びます。全12問、75秒。正解で10点。矢印キーで移動し、EnterまたはSpaceで選べます。</p>\n    <button type=\"button\" id=\"start\" data-text=\"start\">スタート</button>\n  </section>\n  <section id=\"play-screen\" hidden>\n    <h2 tabindex=\"-1\" data-text=\"choose\">同じ形の箱を選ぼう</h2>\n    <div class=\"stats\"><span id=\"progress\"></span><span id=\"score\"></span><span id=\"clock\"></span></div>\n    <div class=\"item\"><span class=\"shape\" id=\"shape\" aria-hidden=\"true\"></span><strong id=\"item-name\"></strong></div>\n    <div class=\"bins\" id=\"bins\"></div>\n    <p id=\"feedback\" role=\"status\"></p>\n  </section>\n  <section id=\"result-screen\" hidden>\n    <h2 tabindex=\"-1\" id=\"result-heading\"></h2>\n    <p id=\"result-score\"></p>\n    <button type=\"button\" id=\"retry\" data-text=\"retry\">もう一度</button>\n    <button type=\"button\" id=\"back\" data-text=\"back\">タイトルへ</button>\n  </section>\n</main>\n<script>\n  const strings = {\n    ja: { title: '分けて、つなごう', story: '集会室で開く交換会の準備を手伝おう。形を見て、遊び道具を箱へ戻します。', language: '言語',\n      instructions: '遊び方', how: '道具と同じ形の箱を選びます。全12問、75秒。正解で10点。矢印キーで移動し、EnterまたはSpaceで選べます。',\n      start: 'スタート', choose: '同じ形の箱を選ぼう', score: 'スコア', time: '残り', count: '問題', success: 'クリア！', expired: '時間切れ',\n      retry: 'もう一度', back: 'タイトルへ', mute: 'ミュート', right: 'ぴったり！', wrong: 'マークの形を見て、もう一度。', box: 'の箱' },\n    en: { title: 'Sort Together', story: 'Help prepare for the toy swap in the community room. Put each toy in the box with its matching shape.', language: 'Language',\n      instructions: 'How to play', how: 'Choose the matching box. There are 12 toys and 75 seconds. Each match is worth 10 points. Use arrow keys to move and Enter or Space to choose.',\n      start: 'Start', choose: 'Choose the matching box', score: 'Score', time: 'Time', count: 'Toy', success: 'Complete!', expired: 'Time is up',\n      retry: 'Play again', back: 'Back to title', mute: 'Mute', right: 'A perfect match!', wrong: 'Look at the shape and try again.', box: ' box' },\n  };\n  const toys = [\n    { symbol: '●', item: { ja: '丸いコマ', en: 'Round top' }, label: { ja: '丸', en: 'Circle' } },\n    { symbol: '■', item: { ja: '四角い積み木', en: 'Square block' }, label: { ja: '四角', en: 'Square' } },\n    { symbol: '★', item: { ja: '星形の飾り', en: 'Star decoration' }, label: { ja: '星', en: 'Star' } },\n  ];\n  const order = [0, 1, 2, 1, 0, 2, 0, 2, 1, 2, 1, 0];\n  const get = (id) => document.getElementById(id);\n  const screens = [...document.querySelectorAll('main > section')];\n  let current = 'title';\n  let language = 'ja';\n  let index = 0;\n  let deadline = 0;\n  let timer;\n  let hintTimer;\n  let hint = '';\n  let muted = false;\n  let audio;\n\n  const words = () => strings[language];\n  const bins = toys.map((toy, i) => {\n    const button = document.createElement('button');\n    button.type = 'button';\n    const shape = document.createElement('span');\n    shape.className = 'shape';\n    shape.setAttribute('aria-hidden', 'true');\n    shape.textContent = toy.symbol;\n    const label = document.createElement('span');\n    button.append(shape, label);\n    button.addEventListener('click', () => choose(i));\n    get('bins').append(button);\n    return button;\n  });\n\n  function screen(name) {\n    current = name;\n    screens.forEach((element) => { element.hidden = element.id !== `${name}-screen`; });\n    get(`${name}-screen`).querySelector('[tabindex=\"-1\"]').focus();\n  }\n\n  function showRound() {\n    const toy = toys[order[index]];\n    get('shape').textContent = toy.symbol;\n    get('item-name').textContent = toy.item[language];\n    get('progress').textContent = `${words().count} ${index + 1} / ${order.length}`;\n    get('score').textContent = `${words().score} ${index * 10}`;\n    get('feedback').textContent = hint ? words()[hint] : '';\n  }\n\n  function tick() {\n    const seconds = Math.max(0, Math.ceil((deadline - performance.now()) / 1000));\n    get('clock').textContent = `${words().time} ${seconds} s`;\n    if (seconds === 0) finish();\n  }\n\n  function showResult() {\n    get('result-heading').textContent = index === order.length ? words().success : words().expired;\n    get('result-score').textContent = `${words().score} ${index * 10} / ${order.length * 10}`;\n  }\n\n  function clearHint() {\n    clearTimeout(hintTimer);\n    bins.forEach((bin) => bin.removeAttribute('data-hint'));\n  }\n\n  function finish() {\n    clearInterval(timer);\n    clearHint();\n    showResult();\n    screen('result');\n  }\n\n  function play() {\n    clearInterval(timer);\n    clearHint();\n    index = 0;\n    hint = '';\n    deadline = performance.now() + 75000;\n    showRound();\n    tick();\n    timer = setInterval(tick, 100);\n    screen('play');\n  }\n\n  function tone(frequency) {\n    if (muted || !window.AudioContext) return;\n    try {\n      audio ??= new AudioContext();\n      audio.resume().catch(() => {});\n      const note = audio.createOscillator();\n      const gain = audio.createGain();\n      note.frequency.value = frequency;\n      gain.gain.setValueAtTime(.04, audio.currentTime);\n      gain.gain.exponentialRampToValueAtTime(.001, audio.currentTime + .12);\n      note.connect(gain).connect(audio.destination);\n      note.start();\n      note.stop(audio.currentTime + .13);\n    } catch { /* Visual feedback is available when audio is blocked. */ }\n  }\n\n  function choose(choice) {\n    if (current !== 'play') return;\n    if (performance.now() >= deadline) return finish();\n    clearHint();\n    if (choice === order[index]) {\n      tone(610);\n      index += 1;\n      hint = 'right';\n      if (index === order.length) return finish();\n    } else {\n      tone(360);\n      hint = 'wrong';\n      bins[order[index]].setAttribute('data-hint', '');\n      hintTimer = setTimeout(clearHint, 850);\n    }\n    showRound();\n  }\n\n  get('language').addEventListener('change', (event) => {\n    language = event.target.value;\n    translate();\n  });\n  function translate() {\n    document.documentElement.lang = language;\n    document.title = words().title;\n    document.querySelectorAll('[data-text]').forEach((element) => { element.textContent = words()[element.dataset.text]; });\n    bins.forEach((bin, i) => { bin.lastElementChild.textContent = toys[i].label[language] + words().box; });\n    if (current === 'play') { showRound(); tick(); }\n    if (current === 'result') showResult();\n  }\n  get('bins').addEventListener('keydown', (event) => {\n    const offset = { ArrowLeft: -1, ArrowUp: -1, ArrowRight: 1, ArrowDown: 1 }[event.key];\n    if (!offset) return;\n    event.preventDefault();\n    const selected = bins.indexOf(document.activeElement);\n    bins[(selected + offset + bins.length) % bins.length].focus();\n  });\n  get('play-screen').querySelector('h2').addEventListener('keydown', (event) => {\n    if (!event.key.startsWith('Arrow')) return;\n    event.preventDefault();\n    bins[0].focus();\n  });\n  get('sound').addEventListener('click', (event) => {\n    muted = !muted;\n    event.currentTarget.setAttribute('aria-pressed', String(muted));\n  });\n  get('instructions').addEventListener('click', () => screen('instructions'));\n  get('start').addEventListener('click', play);\n  get('retry').addEventListener('click', play);\n  get('back').addEventListener('click', () => screen('title'));\n  translate();\n</script>\n</html>\n"}
