{"title":"gemini-code-1793782918584","html":"<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>東大島 防災体験ゲーム / Higashioshima Disaster Prevention Game</title>\n    <style>\n        :root {\n            --bg-color: #18251F;\n            --text-color: #F8F7EE;\n            --accent-color: #DDEB98;\n            --card-bg: #23352C;\n            --btn-hover: #EBF3B5;\n            --danger-color: #E06D53;\n        }\n        * {\n            box-sizing: border-box;\n            user-select: none;\n            -webkit-user-select: none;\n        }\n        body {\n            margin: 0;\n            padding: 0;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            font-family: system-ui, -apple-system, sans-serif;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            min-height: 100vh;\n            overflow: hidden;\n        }\n        #game-container {\n            width: 100%;\n            max-width: 480px;\n            height: 100vh;\n            max-height: 850px;\n            background-color: var(--card-bg);\n            display: flex;\n            flex-direction: column;\n            position: relative;\n            box-shadow: 0 10px 25px rgba(0,0,0,0.5);\n            overflow: hidden;\n        }\n        header {\n            padding: 12px 16px;\n            background: rgba(0,0,0,0.2);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            border-bottom: 1px solid rgba(255,255,255,0.1);\n        }\n        .header-title {\n            font-size: 1rem;\n            font-weight: bold;\n            color: var(--accent-color);\n        }\n        .header-controls {\n            display: flex;\n            gap: 8px;\n            align-items: center;\n        }\n        button {\n            background-color: var(--accent-color);\n            color: var(--bg-color);\n            border: none;\n            padding: 8px 12px;\n            border-radius: 8px;\n            font-weight: bold;\n            font-size: 0.9rem;\n            cursor: pointer;\n            transition: transform 0.1s, background-color 0.2s;\n        }\n        button:active {\n            transform: scale(0.95);\n        }\n        button:hover {\n            background-color: var(--btn-hover);\n        }\n        .screen {\n            flex: 1;\n            display: none;\n            flex-direction: column;\n            padding: 20px;\n            overflow-y: auto;\n            position: relative;\n        }\n        .screen.active {\n            display: flex;\n        }\n        h1, h2 {\n            margin-top: 0;\n            color: var(--accent-color);\n        }\n        p {\n            line-height: 1.5;\n            margin: 8px 0;\n        }\n        .bilingual-en {\n            font-size: 0.85rem;\n            opacity: 0.8;\n            margin-bottom: 12px;\n        }\n        .stats-bar {\n            display: flex;\n            justify-content: space-between;\n            background: rgba(0,0,0,0.3);\n            padding: 8px 12px;\n            border-radius: 8px;\n            margin-bottom: 12px;\n            font-size: 0.9rem;\n        }\n        /* Canvas & Play Area */\n        #play-canvas {\n            width: 100%;\n            height: 240px;\n            background: #111B17;\n            border-radius: 12px;\n            margin-bottom: 12px;\n            display: block;\n        }\n        .choices-container {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n            margin-top: auto;\n            margin-bottom: 16px;\n        }\n        .choice-btn {\n            background-color: #2F473B;\n            color: var(--text-color);\n            border: 2px solid var(--accent-color);\n            padding: 12px 16px;\n            border-radius: 10px;\n            text-align: left;\n            font-size: 1rem;\n            cursor: pointer;\n            transition: background 0.2s;\n        }\n        .choice-btn:hover {\n            background-color: #3C5C4D;\n        }\n        /* D-Pad controls */\n        .controls-pad {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 8px;\n            margin-top: 10px;\n        }\n        .pad-btn {\n            background: #355344;\n            color: var(--text-color);\n            padding: 14px;\n            font-size: 1.2rem;\n            border-radius: 8px;\n            border: 1px solid rgba(255,255,255,0.2);\n            text-align: center;\n        }\n        .pad-btn:active {\n            background: var(--accent-color);\n            color: var(--bg-color);\n        }\n        .feedback-box {\n            background: rgba(0,0,0,0.4);\n            border-left: 4px solid var(--accent-color);\n            padding: 12px;\n            border-radius: 0 8px 8px 0;\n            margin: 12px 0;\n        }\n    </style>\n</head>\n<body>\n\n<div id=\"game-container\">\n    <header>\n        <div class=\"header-title\" id=\"lbl-app-title\">東大島防災ゲーム</div>\n        <div class=\"header-controls\">\n            <button id=\"btn-lang\" onclick=\"toggleLanguage()\">EN / 日本語</button>\n            <button id=\"btn-sound\" onclick=\"toggleSound()\">🔊 ON</button>\n        </div>\n    </header>\n\n    <!-- 1. タイトル画面 -->\n    <div id=\"screen-title\" class=\"screen active\">\n        <h1 id=\"t-main-title\">てーがん：東大島で地震が起きた！</h1>\n        <p class=\"bilingual-en\">Higashioshima Earthquake Evacuation Simulation</p>\n        <div style=\"text-align: center; margin: 30px 0;\">\n            <svg width=\"120\" height=\"120\" viewBox=\"0 0 100 100\">\n                <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"#23352C\" stroke=\"#DDEB98\" stroke-width=\"4\"/>\n                <text x=\"50\" y=\"58\" font-size=\"40\" text-anchor=\"middle\">🏃‍♂️</text>\n            </svg>\n        </div>\n        <p id=\"t-desc\">地震発生時の安全確保と避難行動を体験しよう。自分の判断でスコアと行動が変わります。</p>\n        <p class=\"bilingual-en\">Experience post-earthquake safety actions and evacuation decisions.</p>\n        <div style=\"margin-top: auto;\">\n            <button style=\"width:100%; padding: 16px; font-size: 1.1rem;\" onclick=\"startGame()\">あそぶ / Start Game</button>\n        </div>\n    </div>\n\n    <!-- 2. 遊び方説明画面 -->\n    <div id=\"screen-intro\" class=\"screen\">\n        <h2 id=\"i-title\">あそびかた / How to Play</h2>\n        <div class=\"feedback-box\">\n            <p id=\"i-rule1\">⏱️ 制限時間は120秒です。</p>\n            <p class=\"bilingual-en\">Time limit is 120 seconds.</p>\n            <p id=\"i-rule2\">🕹️ 矢印キーまたは下のボタンで選択・移動します。</p>\n            <p class=\"bilingual-en\">Use arrow keys or buttons below to navigate.</p>\n            <p id=\"i-rule3\">🎯 正解・不正解ではなく、災害時の適切な行動判断を学びます。</p>\n            <p class=\"bilingual-en\">Learn proper disaster judgment through choices.</p>\n        </div>\n        <div style=\"margin-top: auto;\">\n            <button style=\"width:100%; padding: 16px; font-size: 1.1rem;\" onclick=\"startPlay()\">スタートする / Begin</button>\n        </div>\n    </div>\n\n    <!-- 3. メインプレイ画面 -->\n    <div id=\"screen-play\" class=\"screen\">\n        <div class=\"stats-bar\">\n            <span id=\"txt-timer\">⏱️ 残り 120秒</span>\n            <span id=\"txt-score\">⭐ スコア: 0点</span>\n        </div>\n        \n        <canvas id=\"play-canvas\" width=\"440\" height=\"220\"></canvas>\n        \n        <h3 id=\"stage-title\" style=\"margin: 4px 0; color: var(--accent-color);\">場面1: ゆれた！</h3>\n        <p id=\"stage-desc\" style=\"font-size: 0.95rem;\">大きな揺れが来ました。東大島駅近くの部屋でどう身を守りますか？</p>\n        <p id=\"stage-desc-en\" class=\"bilingual-en\">A strong shake occurred. How do you protect yourself?</p>\n\n        <div id=\"choices-area\" class=\"choices-container\">\n            <!-- 選択肢が動的に入る -->\n        </div>\n\n        <div class=\"controls-pad\">\n            <div class=\"pad-btn\" onclick=\"handleInput('left')\">◀</div>\n            <div class=\"pad-btn\" onclick=\"handleInput('enter')\">● 決定</div>\n            <div class=\"pad-btn\" onclick=\"handleInput('right')\">▶</div>\n        </div>\n    </div>\n\n    <!-- 4. リザルト画面 -->\n    <div id=\"screen-result\" class=\"screen\">\n        <h2 id=\"r-title\">げーんしりょう / Result</h2>\n        <p class=\"bilingual-en\">Evacuation Summary</p>\n        \n        <div class=\"feedback-box\">\n            <h3 id=\"r-score-display\">スコア: 0点 / 50点</h3>\n            <p id=\"r-comment\">よくがんばりました！安全な行動を確認できました。</p>\n            <p class=\"bilingual-en\">Good job checking safe evacuation steps!</p>\n        </div>\n\n        <div style=\"margin-top: auto; display: flex; gap: 10px;\">\n            <button style=\"flex:1; padding: 14px;\" onclick=\"resetGame()\">もういちど / Retry</button>\n            <button style=\"flex:1; padding: 14px; background: #355344; color: var(--text-color);\" onclick=\"goToTitle()\">タイトルへ / Title</button>\n        </div>\n    </div>\n</div>\n\n<script>\n    // ----- 設定ブロック -----\n    const CONFIG = {\n        gameTitle: \"東大島 防災ゲーム\",\n        timeLimit: 120,\n        staffCode: \"1234\",\n        nextDestination: \"集会所 / Community Hall\"\n    };\n\n    // 多言語辞書\n    const langData = {\n        ja: {\n            appTitle: \"東大島防災ゲーム\",\n            title: \"東大島で地震が起きた！\",\n            desc: \"地震発生時の安全確保と避難行動を体験しよう。自分の判断でスコアと行動が変わります。\",\n            startBtn: \"あそぶ / Start Game\",\n            introTitle: \"あそびかた\",\n            rule1: \"⏱️ 制限時間は120秒です。\",\n            rule2: \"🕹️ 矢印キーまたは下のボタンで選択・移動します。\",\n            rule3: \"🎯 災害時の適切な行動判断を体験します。\",\n            beginBtn: \"スタートする / Begin\",\n            resultTitle: \"3日間の体験結果\",\n            retryBtn: \"もういちど\",\n            titleBtn: \"タイトルへ\"\n        },\n        en: {\n            appTitle: \"Higashioshima Safety Game\",\n            title: \"Earthquake in Higashioshima!\",\n            desc: \"Experience post-earthquake safety actions. Your choices shape your outcome.\",\n            startBtn: \"Start Game\",\n            introTitle: \"How to Play\",\n            rule1: \"⏱️ Time limit: 120 seconds.\",\n            rule2: \"🕹️ Use arrow keys or pad buttons.\",\n            rule3: \"🎯 Experience safety judgment during disasters.\",\n            beginBtn: \"Begin\",\n            resultTitle: \"Evacuation Result\",\n            retryBtn: \"Retry\",\n            titleBtn: \"Title\"\n        }\n    };\n\n    let currentLang = 'ja';\n    let soundEnabled = true;\n    let timer = 120;\n    let score = 0;\n    let timerInterval = null;\n    let currentStage = 0;\n\n    // ゲームステージデータ\n    const stages = [\n        {\n            titleJa: \"場面1: ゆれた！ (発災直後)\",\n            titleEn: \"Stage 1: The Shake! (Immediate Response)\",\n            descJa: \"大きな揺れが起きました！室内でまずとるべき行動はどれですか？\",\n            descEn: \"A strong earthquake started! What is the best immediate action?\",\n            choices: [\n                { textJa: \"机の下にもぐり、頭を守る\", textEn: \"Hide under a sturdy desk and protect head\", points: 10, feedback: \"正解！落下物から体を守る基本行動です。\" },\n                { textJa: \"あわてて外へ飛び出す\", textEn: \"Rush outside immediately\", points: 5, feedback: \"ガラスや看板の落下物に注意が必要です。\" },\n                { textJa: \"窓ガラスのそばで様子を見る\", textEn: \"Watch near the window glass\", points: 0, feedback: \"窓ガラスが割れる危険があります。\" }\n            ]\n        },\n        {\n            titleJa: \"場面2: でんきが きえた (停電)\",\n            titleEn: \"Stage 2: Power Outage\",\n            descJa: \"電気が消えました。足元を確認するために何を使いますか？\",\n            descEn: \"Lights went out. What do you use to check your steps?\",\n            choices: [\n                { textJa: \"スマホのライトや懐中電灯を使う\", textEn: \"Use smartphone light or flashlight\", points: 10, feedback: \"安全に足元の散乱物を確認できました。\" },\n                { textJa: \"暗いまま急いで歩く\", textEn: \"Walk fast in the dark\", points: 2, feedback: \"割れたガラスなどでケガをする恐れがあります。\" }\n            ]\n        },\n        {\n            titleJa: \"場面3: エレベーターがとまった\",\n            titleEn: \"Stage 3: Elevator Stoppage\",\n            descJa: \"上の階から避難します。移動手段はどうしますか？\",\n            descEn: \"Evacuating from upper floors. How do you move?\",\n            choices: [\n                { textJa: \"階段を使って安全に降りる\", textEn: \"Use stairs safely\", points: 10, feedback: \"余震で閉じ込められるリスクを防げました。\" },\n                { textJa: \"動かないエレベーターを無理にこじ開ける\", textEn: \"Try to force open the elevator\", points: 0, feedback: \"閉じ込めや急落下事故の危険があり危険です。\" }\n            ]\n        },\n        {\n            titleJa: \"場面4: まちなかの避難\",\n            titleEn: \"Stage 4: Outdoor Evacuation\",\n            descJa: \"東大島駅周辺の屋外へ出ました。ブロック塀の近くを通りますか？\",\n            descEn: \"Outdoors near Higashioshima. Pass near concrete block walls?\",\n            choices: [\n                { textJa: \"ブロック塀から離れて歩く\", textEn: \"Walk away from block walls\", points: 10, feedback: \"倒壊の危険を避ける安全なルートです。\" },\n                { textJa: \"近道なので塀のすぐ横を通る\", textEn: \"Take shortcut right beside the wall\", points: 0, feedback: \"余震で塀が倒れる危険があります。\" }\n            ]\n        }\n    ];\n\n    // Web Audio API による簡易効果音\n    let audioCtx = null;\n    function playSound(type) {\n        if (!soundEnabled) return;\n        try {\n            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n            let osc = audioCtx.createOscillator();\n            let gain = audioCtx.createGain();\n            osc.connect(gain);\n            gain.connect(audioCtx.destination);\n            \n            if (type === 'click') {\n                osc.frequency.setValueAtTime(440, audioCtx.currentTime);\n                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.1);\n            } else if (type === 'correct') {\n                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);\n                osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.1);\n                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);\n                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);\n                osc.start();\n                osc.stop(audioCtx.currentTime + 0.3);\n            }\n        } catch(e) {}\n    }\n\n    function toggleLanguage() {\n        currentLang = currentLang === 'ja' ? 'en' : 'ja';\n        updateTexts();\n    }\n\n    function toggleSound() {\n        soundEnabled = !soundEnabled;\n        document.getElementById('btn-sound').innerText = soundEnabled ? '🔊 ON' : '🔇 OFF';\n    }\n\n    function updateTexts() {\n        const d = langData[currentLang];\n        document.getElementById('lbl-app-title').innerText = CONFIG.gameTitle;\n        document.getElementById('t-main-title').innerText = d.title;\n        document.getElementById('t-desc').innerText = d.desc;\n        document.getElementById('i-title').innerText = d.introTitle;\n        document.getElementById('i-rule1').innerText = d.rule1;\n        document.getElementById('i-rule2').innerText = d.rule2;\n        document.getElementById('i-rule3').innerText = d.rule3;\n        document.getElementById('r-title').innerText = d.resultTitle;\n    }\n\n    function showScreen(screenId) {\n        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n        document.getElementById(screenId).classList.add('active');\n    }\n\n    function startGame() {\n        playSound('click');\n        showScreen('screen-intro');\n    }\n\n    function startPlay() {\n        playSound('click');\n        timer = CONFIG.timeLimit;\n        score = 0;\n        currentStage = 0;\n        showScreen('screen-play');\n        updateTimerDisplay();\n        loadStage();\n\n        if (timerInterval) clearInterval(timerInterval);\n        timerInterval = setInterval(() => {\n            timer--;\n            updateTimerDisplay();\n            if (timer <= 0) {\n                clearInterval(timerInterval);\n                endGame();\n            }\n        }, 1000);\n    }\n\n    function updateTimerDisplay() {\n        document.getElementById('txt-timer').innerText = `⏱️ 残り ${timer}秒`;\n        document.getElementById('txt-score').innerText = `⭐ スコア: ${score}点`;\n    }\n\n    function loadStage() {\n        if (currentStage >= stages.length) {\n            clearInterval(timerInterval);\n            endGame();\n            return;\n        }\n\n        const stage = stages[currentStage];\n        document.getElementById('stage-title').innerText = currentLang === 'ja' ? stage.titleJa : stage.titleEn;\n        document.getElementById('stage-desc').innerText = currentLang === 'ja' ? stage.descJa : stage.descEn;\n\n        const container = document.getElementById('choices-area');\n        container.innerHTML = '';\n\n        stage.choices.forEach((choice, index) => {\n            const btn = document.createElement('button');\n            btn.className = 'choice-btn';\n            btn.innerText = `${index + 1}. ${currentLang === 'ja' ? choice.textJa : choice.textEn}`;\n            btn.onclick = () => selectChoice(choice);\n            container.appendChild(btn);\n        });\n\n        drawCanvasScene();\n    }\n\n    function selectChoice(choice) {\n        playSound('correct');\n        score += choice.points;\n        alert(choice.feedback);\n        currentStage++;\n        loadStage();\n    }\n\n    function handleInput(action) {\n        playSound('click');\n        // キーボードおよびボタン操作時の簡易処理\n    }\n\n    function drawCanvasScene() {\n        const canvas = document.getElementById('play-canvas');\n        const ctx = canvas.getContext('2d');\n        ctx.fillStyle = '#111B17';\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n        // 簡易絵本風背景（道路と建物）\n        ctx.fillStyle = '#23352C';\n        ctx.fillRect(40, 40, 100, 140);\n        ctx.fillRect(300, 40, 100, 140);\n\n        ctx.fillStyle = '#1A2921';\n        ctx.beginPath();\n        ctx.moveTo(160, 220);\n        ctx.lineTo(220, 80);\n        ctx.lineTo(260, 80);\n        ctx.lineTo(320, 220);\n        ctx.fill();\n\n        // キャラクター（アイコン風）\n        ctx.font = '32px sans-serif';\n        ctx.fillText('🏃', 200, 160);\n    }\n\n    function endGame() {\n        if (timerInterval) clearInterval(timerInterval);\n        showScreen('screen-result');\n        document.getElementById('r-score-display').innerText = `スコア: ${score}点 / 40点`;\n        document.getElementById('r-comment').innerText = `おつかれさまでした！つぎの目的地: ${CONFIG.nextDestination}`;\n    }\n\n    function resetGame() {\n        playSound('click');\n        startPlay();\n    }\n\n    function goToTitle() {\n        playSound('click');\n        showScreen('screen-title');\n    }\n\n    // キーボード操作対応\n    window.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter' || e.key === ' ') {\n            handleInput('enter');\n        }\n    });\n</script>\n\n</body>\n</html>"}